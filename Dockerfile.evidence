FROM node:20-slim
WORKDIR /app

# Install Evidence CLI + plugins at image build time
# pages/, sources/, and scripts/ are volume-mounted at runtime
COPY evidence/package*.json ./
COPY evidence/evidence.config.yaml ./
RUN npm install --include=dev

# Placeholders replaced by volume mounts at runtime
RUN mkdir -p pages sources scripts

EXPOSE 3000
# 1. Symlink olap.duckdb into sources/datalake/ so Evidence copies it to template (absolute target resolves in-container)
# 2. Run Evidence sources; 3. Build static site; 4. Serve
CMD ["sh", "-c", "cp /app/var/data_lake/serving/olap.duckdb /app/sources/datalake/olap-serving.duckdb && npm run sources && npm run build && npm run preview"]
