FROM node:20-slim
WORKDIR /app

# curl required for HEALTHCHECK
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Non-root user — created before npm install so node_modules are owned correctly
RUN useradd -r -u 1001 -g node app

# Install Evidence CLI + plugins at image build time (cached separately from config)
COPY evidence/package*.json ./
RUN npm install --include=dev

# Config files (copied after npm install to preserve cache on pkg change)
COPY evidence/evidence.config.yaml ./

# Placeholders replaced by volume mounts at runtime; chown so non-root can write at startup
RUN mkdir -p pages sources scripts && chown -R 1001:node /app

USER 1001

EXPOSE 3000

# Healthcheck: Evidence preview server serves HTTP once static build is complete.
# start-period is long because Evidence build (sources + build) takes 60-120s.
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=5 \
    CMD curl -f http://localhost:3000/ || exit 1

# 1. Copy olap.duckdb into sources/datalake/ for Evidence to use
# 2. Run Evidence sources; 3. Build static site
# 4. Patch built HTML: default theme 'dark' instead of 'system'
# 5. Serve
CMD ["sh", "-c", "cp /app/var/data_lake/serving/olap.duckdb /app/sources/datalake/olap-serving.duckdb && npm run sources && npm run build && find /app/build -name '*.html' -exec sed -i \"s/?? 'system'/?? 'dark'/g\" {} + && npm run preview"]
