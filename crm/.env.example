# CRM server configuration
# Copy to .env and adjust as needed. Never commit .env.

# Directory for SQLite database files (crm.db + cache.db)
# Default: ./data  (relative to binary working directory)
CRM_DATA_DIR=./data

# HTTP listen port
CRM_PORT=8090

# Shared secret for POST /admin/refresh. When set, requests must send a matching
# X-Refresh-Token header (else 401). Leave unset/empty to leave the endpoint open
# (LAN-trust only — a warning is logged at startup).
CRM_REFRESH_TOKEN=

# Path to the refresh script run by POST /admin/refresh.
# Default: /app/refresh.sh (baked into the container image).
CRM_REFRESH_SCRIPT=/app/refresh.sh

# ── Hug token provisioning (local-side) ──────────────────────────────────────
# Public scan domain baked into printed QR codes: https://{HUG_DOMAIN}/h/{token}
# (custom domain on the same webhook-receiver Worker; path /h/ matches GET /h/:token)
HUG_DOMAIN=hug.fjp.vn

# Base URL of the deployed Cloudflare Worker (M2). LEAVE UNSET until the Worker
# is deployed — the claim station then binds tokens locally and SKIPS the D1
# push (logs "pending deploy"). Set this post-deploy to enable the edge push.
HUG_WORKER_URL=

# Shared secret for the HMAC X-Hug-Signature header on POST /hug/token/upsert.
# Required only when HUG_WORKER_URL is set. Must match the Worker's secret.
HUG_ADMIN_SECRET=

# Optional explicit hug.db path (default: {CRM_DATA_DIR}/hug.db).
# HUG_DB=./data/hug.db
