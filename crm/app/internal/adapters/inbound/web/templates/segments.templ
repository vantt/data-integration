package templates

import (
	"fmt"
	"github.com/vantt/data-integration/crm/app/internal/domain"
)

// ── S08 Segments List ─────────────────────────────────────────────────────────

// SegmentsPage renders S08 — Segments List.
templ SegmentsPage(segments []domain.Segment, memberCounts map[string]int) {
	@AppShell("S08", "Segments") {
		<div class="crm-page page-enter" data-surface="S08">
			<div class="crm-pagehead">
				<div>
					<div class="caption crm-pagehead__eyebrow">SEGMENTS</div>
					<h1 class="crm-pagehead__title">Phân khúc khách hàng</h1>
				</div>
				<div class="crm-pagehead__aside">
					<a class="btn btn--primary" href="/segments/new">
						@Icon("plus", 13)
						Tạo segment
					</a>
				</div>
			</div>
			<div class="toolbar">
				<label class="toolbar__search">
					@Icon("search", 14)
					<input
						type="search"
						name="q"
						placeholder="Tìm theo tên segment..."
						hx-get="/segments"
						hx-trigger="input changed delay:300ms"
						hx-target="#segments-table"
						hx-swap="innerHTML"
					/>
				</label>
			</div>
			<div id="segments-table">
				@SegmentsTable(segments, memberCounts)
			</div>
		</div>
	}
}

// SegmentsTable renders the segment list table (also used as HTMX fragment).
templ SegmentsTable(segments []domain.Segment, memberCounts map[string]int) {
	if len(segments) == 0 {
		<div class="state">
			<div class="state__inner">
				<div class="state__title">Chưa có segment nào</div>
				<p class="state__sub">Tạo segment đầu tiên để phân loại khách hàng theo rule.</p>
				<div class="state__actions">
					<a href="/segments/new" class="btn btn--primary">
						@Icon("plus", 13)
						Tạo segment
					</a>
				</div>
			</div>
		</div>
	} else {
		<div class="tbl-wrap">
			<table class="tbl">
				<thead>
					<tr>
						<th>Tên</th>
						<th>Loại</th>
						<th class="num-h">Thành viên</th>
						<th>Cập nhật</th>
						<th>Trạng thái</th>
						<th class="th-go"></th>
					</tr>
				</thead>
				<tbody>
					for _, seg := range segments {
						<tr
							class="is-clickable"
							id={ "seg-" + seg.SegmentID }
							hx-get={ "/segments/" + seg.SegmentID }
							hx-target="body"
							hx-push-url="true"
						>
							<td>
								<span class="cell-strong">{ seg.Name }</span>
								if seg.Description != "" {
									<span class="cell-sub">{ truncStr(seg.Description, 60) }</span>
								}
							</td>
							<td>
								if seg.IsDynamic {
									<span class="bdg bdg--accent">dynamic</span>
								} else {
									<span class="bdg">static</span>
								}
							</td>
							<td class="num">
								if memberCounts[seg.SegmentID] == 0 {
									<span class="bdg bdg--warn">0</span>
								} else {
									{ fmt.Sprintf("%d", memberCounts[seg.SegmentID]) }
								}
							</td>
							<td class="mono muted">{ formatICTHelper(seg.UpdatedAt) }</td>
							<td>
								if seg.IsDynamic {
									<span class="status status--ready">ready</span>
								} else {
									<span class="bdg">static</span>
								}
							</td>
							<td class="td-go">
								<span class="go-arrow">
									@Icon("chevron", 14)
								</span>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// SegmentRowRefreshed renders a single refreshed segment row (HTMX swap target).
templ SegmentRowRefreshed(seg domain.Segment, memberCount int) {
	<tr
		class="is-clickable"
		id={ "seg-" + seg.SegmentID }
		hx-get={ "/segments/" + seg.SegmentID }
		hx-target="body"
		hx-push-url="true"
	>
		<td>
			<span class="cell-strong">{ seg.Name }</span>
		</td>
		<td>
			if seg.IsDynamic {
				<span class="bdg bdg--accent">dynamic</span>
			} else {
				<span class="bdg">static</span>
			}
		</td>
		<td class="num">
			if memberCount == 0 {
				<span class="bdg bdg--warn">0</span>
			} else {
				{ fmt.Sprintf("%d", memberCount) }
			}
		</td>
		<td class="mono muted">{ formatICTHelper(seg.UpdatedAt) }</td>
		<td>
			if seg.IsDynamic {
				<span class="status status--ready">ready</span>
			} else {
				<span class="bdg">static</span>
			}
		</td>
		<td class="td-go">
			<span class="go-arrow">
				@Icon("chevron", 14)
			</span>
		</td>
	</tr>
}

// ── S09 Segment Builder ───────────────────────────────────────────────────────

// SegmentBuilderPage renders S09 — Segment Builder (new or edit).
templ SegmentBuilderPage(seg *domain.Segment, members []domain.SegmentMember, isNew bool) {
	@AppShell("S08", "Segment Builder") {
		<div class="crm-page page-enter" data-surface="S09">
			<!-- single form wraps topbar + builder-grid so all inputs submit together -->
			<form
				if isNew {
					hx-post="/segments"
				} else {
					hx-put={ "/segments/" + seg.SegmentID }
				}
				hx-target="body"
				hx-push-url="true"
			>
				<!-- S09 topbar: back breadcrumb · name input · type radio-pills -->
				<div class="c360-topbar">
					<a class="c360-back" href="/segments">
						@Icon("back", 13)
						Segments
					</a>
					<div class="c360-id">
						<input
							type="text"
							name="name"
							class="inp"
							value={ seg.Name }
							required
							placeholder="Tên segment..."
						/>
					</div>
					<div class="c360-actions">
						<!-- is_dynamic submitted as hidden; radio-pills are visual only -->
						<input
							type="hidden"
							name="is_dynamic"
							value={ boolStr(seg.IsDynamic) }
						/>
						<div class="radioset">
							<label class={ "radio-pill" + boolClass(seg.IsDynamic, " radio-pill--on") }>
								<span class="radio-pill__dot"></span>
								Dynamic
							</label>
							<label class={ "radio-pill" + boolClass(!seg.IsDynamic, " radio-pill--on") }>
								<span class="radio-pill__dot"></span>
								Static
							</label>
						</div>
					</div>
				</div>

				<!-- S09 2-column layout: rule editor (left) + preview panel (right) -->
				<div class="builder-grid">
					<!-- Left: rule editor with condition rows -->
					<div class="rule-editor">
						<div class="caption">Điều kiện (AND — chỉ áp dụng cho Dynamic)</div>
						@segmentRuleFields(seg)
						<!-- Read-only JSON definition preview -->
						if seg != nil && seg.Definition != "" {
							<div class="caveat caveat--info">
								<span class="caveat__mark">JSON</span>
								<pre class="mono">{ seg.Definition }</pre>
							</div>
						}
						<div class="panel-head">
							<a href="/segments" class="btn btn--ghost">Hủy</a>
							<button type="submit" class="btn btn--primary">
								if isNew {
									Tạo &amp; Lưu
								} else {
									Lưu &amp; Materialize
								}
							</button>
						</div>
					</div>

					<!-- Right: preview panel -->
					<div class="preview-panel">
						<div class="caption">Kết quả dự kiến</div>
						<div class="preview-big">{ fmt.Sprintf("%d", len(members)) }</div>
						<p class="muted">khách khớp rule</p>
						if len(members) == 0 {
							<div class="caveat caveat--warn">0 party khớp — cân nhắc nới rule trước khi lưu.</div>
						}
						if len(members) > 0 {
							<div>
								for i, m := range members {
									if i < 20 {
										<div class="member-mini">
											<span>{ m.PartyID }</span>
											<span class="bdg">{ m.Source }</span>
										</div>
									}
								}
								if len(members) > 20 {
									<div class="caveat caveat--info">
										<span class="caveat__mark">+</span>
										<span>{ fmt.Sprintf("%d", len(members)-20) } khách khác</span>
									</div>
								}
							</div>
						}
						if len(members) == 0 && (seg == nil || seg.Definition == "") {
							<p class="muted">Chưa có thành viên nào. Lưu rồi Refresh để tính.</p>
						}
						<!-- Refresh action for dynamic segments (outside form submit, uses hx-post) -->
						if !isNew && seg != nil && seg.IsDynamic {
							<button
								type="button"
								class="btn btn--ghost"
								hx-post={ "/segments/" + seg.SegmentID + "/refresh" }
								hx-target={ "#seg-" + seg.SegmentID }
								hx-swap="outerHTML"
							>
								@Icon("refresh", 13)
								Refresh
							</button>
						}
					</div>
				</div>
			</form>
		</div>
	}
}

// segmentRuleFields renders the whitelisted rule input fields as DS condition rows.
templ segmentRuleFields(seg *domain.Segment) {
	<!-- value_group condition row -->
	<div class="cond-row">
		<div class="inp-sel">
			<select name="rule_field_1">
				<option value="value_group" selected>value_group</option>
				<option value="customer_status">customer_status</option>
				<option value="recency_days">recency_days</option>
				<option value="channel_preference">channel_preference</option>
			</select>
			<span class="inp-sel__chev">@Icon("chevdown", 12)</span>
		</div>
		<div class="inp-sel">
			<select name="rule_op_1">
				<option value="in" selected>in</option>
				<option value="=">=</option>
				<option value="!=">!=</option>
			</select>
			<span class="inp-sel__chev">@Icon("chevdown", 12)</span>
		</div>
		<div>
			for _, vg := range []string{"VIP", "GOLD", "SILVER", "BRONZE"} {
				<label>
					<input
						type="checkbox"
						name="rule_value_group"
						value={ vg }
						checked?={ segmentHasValueGroup(seg, vg) }
					/>
					<span class={ valueGroupBadgeClassHelper(vg) }>{ vg }</span>
				</label>
			}
		</div>
		<button class="cond-x" type="button" aria-label="Xóa điều kiện">
			@Icon("close", 13)
		</button>
	</div>

	<div class="cond-join">
		<span class="cond-join__line"></span>
		<span class="cond-join__pill">AND</span>
		<span class="cond-join__line"></span>
	</div>

	<!-- customer_status condition row -->
	<div class="cond-row">
		<div class="inp-sel">
			<select name="rule_field_2">
				<option value="value_group">value_group</option>
				<option value="customer_status" selected>customer_status</option>
				<option value="recency_days">recency_days</option>
				<option value="channel_preference">channel_preference</option>
			</select>
			<span class="inp-sel__chev">@Icon("chevdown", 12)</span>
		</div>
		<div class="inp-sel">
			<select name="rule_op_2">
				<option value="=" selected>=</option>
				<option value="!=">!=</option>
			</select>
			<span class="inp-sel__chev">@Icon("chevdown", 12)</span>
		</div>
		<select name="rule_customer_status" class="inp">
			<option value="">-- Tất cả --</option>
			for _, cs := range []string{"active", "at_risk", "churned"} {
				<option value={ cs } selected?={ segmentHasCustomerStatus(seg, cs) }>{ cs }</option>
			}
		</select>
		<button class="cond-x" type="button" aria-label="Xóa điều kiện">
			@Icon("close", 13)
		</button>
	</div>

	<div class="cond-join">
		<span class="cond-join__line"></span>
		<span class="cond-join__pill">AND</span>
		<span class="cond-join__line"></span>
	</div>

	<!-- days_since_last_order_gte condition row -->
	<div class="cond-row">
		<div class="inp-sel">
			<select name="rule_field_3">
				<option value="value_group">value_group</option>
				<option value="customer_status">customer_status</option>
				<option value="recency_days" selected>recency_days</option>
				<option value="channel_preference">channel_preference</option>
			</select>
			<span class="inp-sel__chev">@Icon("chevdown", 12)</span>
		</div>
		<div class="inp-sel">
			<select name="rule_op_3">
				<option value=">=" selected>&gt;=</option>
				<option value=">">&gt;</option>
				<option value="<">&lt;</option>
			</select>
			<span class="inp-sel__chev">@Icon("chevdown", 12)</span>
		</div>
		<input
			type="number"
			name="rule_days_since"
			class="inp"
			min="0"
			value={ segmentDaysSince(seg) }
			placeholder="VD: 60"
		/>
		<button class="cond-x" type="button" aria-label="Xóa điều kiện">
			@Icon("close", 13)
		</button>
	</div>

	<div class="cond-join">
		<span class="cond-join__line"></span>
		<span class="cond-join__pill">AND</span>
		<span class="cond-join__line"></span>
	</div>

	<!-- channel_preference condition row -->
	<div class="cond-row">
		<div class="inp-sel">
			<select name="rule_field_4">
				<option value="value_group">value_group</option>
				<option value="customer_status">customer_status</option>
				<option value="recency_days">recency_days</option>
				<option value="channel_preference" selected>channel_preference</option>
			</select>
			<span class="inp-sel__chev">@Icon("chevdown", 12)</span>
		</div>
		<div class="inp-sel">
			<select name="rule_op_4">
				<option value="=" selected>=</option>
				<option value="!=">!=</option>
			</select>
			<span class="inp-sel__chev">@Icon("chevdown", 12)</span>
		</div>
		<input
			type="text"
			name="rule_channel"
			class="inp"
			value={ segmentChannelPref(seg) }
			placeholder="messenger / zalo / ..."
		/>
		<button class="cond-x" type="button" aria-label="Xóa điều kiện">
			@Icon("close", 13)
		</button>
	</div>

	<!-- Add condition button -->
	<button class="btn btn--ghost" type="button">
		@Icon("plus", 13)
		Thêm điều kiện
	</button>
}

// boolClass returns suffix when cond is true, "" otherwise.
// Used for conditional templ class concatenation.
func boolClass(cond bool, suffix string) string {
	if cond {
		return suffix
	}
	return ""
}

// boolStr converts a bool to its string representation for hidden inputs.
func boolStr(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

// pure helpers — no templ needed

func segmentHasValueGroup(seg *domain.Segment, vg string) bool {
	if seg == nil || seg.Definition == "" {
		return false
	}
	return containsString(seg.Definition, `"`+vg+`"`)
}

func segmentHasCustomerStatus(seg *domain.Segment, cs string) bool {
	if seg == nil || seg.Definition == "" {
		return false
	}
	return containsString(seg.Definition, `"customer_status":"`+cs+`"`)
}

func segmentDaysSince(seg *domain.Segment) string {
	if seg == nil || seg.Definition == "" {
		return ""
	}
	// Extract numeric value after "days_since_last_order_gte":
	idx := findStr(seg.Definition, `"days_since_last_order_gte":`)
	if idx < 0 {
		return ""
	}
	rest := seg.Definition[idx+len(`"days_since_last_order_gte":`):]
	var n string
	for _, c := range rest {
		if c >= '0' && c <= '9' {
			n += string(c)
		} else if n != "" {
			break
		}
	}
	return n
}

func segmentChannelPref(seg *domain.Segment) string {
	if seg == nil || seg.Definition == "" {
		return ""
	}
	prefix := `"channel_preference":"`
	idx := findStr(seg.Definition, prefix)
	if idx < 0 {
		return ""
	}
	rest := seg.Definition[idx+len(prefix):]
	end := findStr(rest, `"`)
	if end < 0 {
		return rest
	}
	return rest[:end]
}

func containsString(s, sub string) bool {
	return findStr(s, sub) >= 0
}

func findStr(s, sub string) int {
	for i := 0; i <= len(s)-len(sub); i++ {
		if s[i:i+len(sub)] == sub {
			return i
		}
	}
	return -1
}
