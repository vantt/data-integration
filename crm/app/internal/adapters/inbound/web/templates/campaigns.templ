package templates

import (
	"fmt"
	"github.com/vantt/data-integration/crm/app/internal/domain"
)

// ── S10 Campaigns List ────────────────────────────────────────────────────────

// CampaignsPage renders S10 — Campaigns List.
templ CampaignsPage(campaigns []domain.Campaign, segmentNames map[string]string) {
	@AppShell("S10", "Chiến dịch") {
		<div class="crm-page page-enter">
			<div class="crm-pagehead">
				<div>
					<div class="caption crm-pagehead__eyebrow">CHIẾN DỊCH</div>
					<h1 class="crm-pagehead__title">Chiến dịch</h1>
				</div>
				<div class="crm-pagehead__aside">
					<button
						class="btn btn--primary"
						hx-get="/campaigns/modal/create"
						hx-target="#modal"
						hx-swap="innerHTML"
					>
						@Icon("plus", 13)
						Tạo chiến dịch
					</button>
				</div>
			</div>
			@CampaignsTable(campaigns, segmentNames)
		</div>
		<div id="modal"></div>
	}
}

// CampaignsTable renders the campaigns list table (also used as HTMX fragment).
templ CampaignsTable(campaigns []domain.Campaign, segmentNames map[string]string) {
	if len(campaigns) == 0 {
		<div class="state">
			<div class="state__inner">
				<div class="state__title">Chưa có chiến dịch nào</div>
				<div class="state__sub">Tạo chiến dịch đầu tiên từ một segment.</div>
				<div class="state__actions">
					<button
						class="btn btn--secondary"
						hx-get="/campaigns/modal/create"
						hx-target="#modal"
						hx-swap="innerHTML"
					>
						@Icon("plus", 13)
						Tạo chiến dịch
					</button>
				</div>
			</div>
		</div>
	} else {
		<div class="toolbar">
			<div class="toolbar__filters">
				<div class="fsel">
					<div class="caption fsel__label">TRẠNG THÁI</div>
					<div class="fsel__field">
						<select
							name="status"
							hx-get="/campaigns"
							hx-target="#campaigns-list"
							hx-swap="innerHTML"
							hx-trigger="change"
						>
							<option value="all">Tất cả</option>
							<option value="draft">Draft</option>
							<option value="running">Active</option>
							<option value="done">Done</option>
						</select>
						<span class="fsel__chev">@Icon("chevdown", 11)</span>
					</div>
				</div>
			</div>
		</div>
		<div class="tbl-wrap">
			<table class="tbl">
				<thead>
					<tr>
						<th>Tên</th>
						<th>Objective</th>
						<th>Kênh</th>
						<th class="num-h">Targets</th>
						<th class="num-h">Converted</th>
						<th class="num-h">Rate</th>
						<th>Trạng thái</th>
						<th class="th-go"></th>
					</tr>
				</thead>
				<tbody>
					for _, c := range campaigns {
						<tr
							class="is-clickable"
							hx-get={ "/campaigns/" + c.CampaignID }
							hx-target="body"
							hx-push-url="true"
						>
							<td>
								<span class="cell-strong">{ c.Name }</span>
								if c.SegmentID != nil {
									<span class="cell-sub">{ segmentNames[*c.SegmentID] }</span>
								}
							</td>
							<td>{ c.Objective }</td>
							<td class="muted">{ c.Channel }</td>
							<td class="num">—</td>
							<td class="num cell-strong">—</td>
							<td class="num">—</td>
							<td>
								<span class={ "bdg " + campaignStatusBdg(c.Status) }>
									<span class="bdg__dot"></span>
									{ c.Status }
								</span>
							</td>
							<td class="td-go">
								<span class="go-arrow">@Icon("chevron", 13)</span>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// ── S11 Campaign Detail / Targets ─────────────────────────────────────────────

// CampaignDetailPage renders S11 — Campaign Detail with ROI summary and target list.
templ CampaignDetailPage(
	campaign *domain.Campaign,
	targets []domain.CampaignTarget,
	roi *domain.CampaignROI,
	partyNames map[string]string,
	segmentName string,
) {
	@AppShell("S10", campaign.Name) {
		<div class="crm-page page-enter">
			// Topbar: back · name+status · actions
			<div class="c360-topbar">
				<a class="c360-back" href="/campaigns">
					@Icon("back", 13)
					Chiến dịch
				</a>
				<div class="c360-id">
					<span class="c360-name">{ campaign.Name }</span>
					<span class={ "bdg " + campaignStatusBdg(campaign.Status) }>
						<span class="bdg__dot"></span>
						{ campaign.Status }
					</span>
				</div>
				<div class="c360-actions">
					<button
						class="btn btn--secondary"
						hx-get={ "/campaigns/" + campaign.CampaignID + "/modal/edit" }
						hx-target="#modal"
						hx-swap="innerHTML"
					>
						@Icon("edit", 13)
						Sửa
					</button>
					if campaign.Status == "draft" {
						<button
							class="btn btn--primary"
							hx-post={ "/campaigns/" + campaign.CampaignID + "/activate" }
							hx-target="body"
						>
							@Icon("bolt", 13)
							Kích hoạt
						</button>
					}
				</div>
			</div>
			// ROI stat strip
			<div id="roi-summary">
				@CampaignROIFragment(roi)
			</div>
			// Action buttons (generate targets / scan conversions)
			<div class="toolbar">
				<div class="toolbar__filters">
					<button
						class="btn btn--secondary"
						hx-post={ "/campaigns/" + campaign.CampaignID + "/generate-targets" }
						hx-target="#targets-section"
						hx-swap="innerHTML"
					>
						@Icon("bolt", 13)
						Tạo targets từ segment
					</button>
					<button
						class="btn btn--secondary"
						hx-post={ "/campaigns/" + campaign.CampaignID + "/scan-conversions" }
						hx-target="#roi-summary"
						hx-swap="innerHTML"
					>
						@Icon("refresh", 13)
						Scan conversions
					</button>
				</div>
			</div>
			// Target list
			<div id="targets-section">
				@CampaignTargetList(campaign.CampaignID, targets, partyNames)
			</div>
		</div>
		<div id="modal"></div>
	}
}

// CampaignROIFragment renders the ROI summary strip (HTMX swap target).
templ CampaignROIFragment(roi *domain.CampaignROI) {
	if roi == nil {
		<div class="caveat caveat--info">
			@Icon("warn", 13)
			Chưa có dữ liệu ROI.
		</div>
	} else {
		<div class="strip-stats">
			<div class="strip-stat">
				<div class="strip-stat__k caption">TARGETS</div>
				<div class="strip-stat__v">{ fmt.Sprintf("%d", roi.TotalTargets) }</div>
			</div>
			<div class="strip-stat">
				<div class="strip-stat__k caption">SENT</div>
				<div class="strip-stat__v">{ fmt.Sprintf("%d", roi.StatusCounts["sent"]) }</div>
			</div>
			<div class="strip-stat">
				<div class="strip-stat__k caption">RESPONDED</div>
				<div class="strip-stat__v">{ fmt.Sprintf("%d", roi.StatusCounts["responded"]) }</div>
			</div>
			<div class="strip-stat">
				<div class="strip-stat__k caption">CONVERTED</div>
				<div class="strip-stat__v">{ fmt.Sprintf("%d", roi.StatusCounts["converted"]) }</div>
			</div>
			<div class="strip-stat">
				<div class="strip-stat__k caption">RATE</div>
				<div class="strip-stat__v">
					if roi.TotalTargets > 0 {
						{ fmt.Sprintf("%.1f%%", float64(roi.StatusCounts["converted"])*100/float64(roi.TotalTargets)) }
					} else {
						—
					}
				</div>
			</div>
		</div>
		<div class="caveat caveat--info">
			@Icon("money", 13)
			Doanh thu attributed: <b>{ formatVNDHelper(roi.TotalConvertedRevVND) }</b> · R11 · order_code mới sau scheduled_at ICT
		</div>
	}
}

// CampaignTargetList renders the target table (also used as HTMX fragment).
templ CampaignTargetList(campaignID string, targets []domain.CampaignTarget, partyNames map[string]string) {
	if len(targets) == 0 {
		<div class="state">
			<div class="state__inner">
				<div class="state__title">Chưa có target</div>
				<div class="state__sub">Segment có 0 member hoặc chiến dịch chưa kích hoạt.</div>
			</div>
		</div>
	} else {
		<div class="toolbar">
			<div class="toolbar__filters">
				<div class="fsel">
					<div class="caption fsel__label">STATUS</div>
					<div class="fsel__field">
						<select
							name="status"
							hx-get={ "/campaigns/" + campaignID + "/targets" }
							hx-target="#targets-section"
							hx-swap="innerHTML"
							hx-trigger="change"
						>
							<option value="all">Tất cả</option>
							<option value="queued">queued</option>
							<option value="sent">sent</option>
							<option value="responded">responded</option>
							<option value="converted">converted</option>
							<option value="skipped">skipped</option>
						</select>
						<span class="fsel__chev">@Icon("chevdown", 11)</span>
					</div>
				</div>
			</div>
		</div>
		<div class="tbl-wrap">
			<table class="tbl">
				<thead>
					<tr>
						<th>Khách</th>
						<th>Status</th>
						<th>Assignee</th>
						<th>Order code</th>
						<th class="num-h">Revenue</th>
						<th class="th-go"></th>
					</tr>
				</thead>
				<tbody>
					for _, t := range targets {
						<tr id={ "target-" + t.PartyID }>
							<td>
								<a class="cell-strong" href={ templ.SafeURL("/customers/" + t.PartyID) }>
									{ partyDisplayName(partyNames, t.PartyID) }
								</a>
							</td>
							<td>
								<span class={ "bdg " + targetStatusBdg(t.Status) }>
									<span class="bdg__dot"></span>
									{ t.Status }
								</span>
							</td>
							<td class="muted">
								if t.AssignedUserID != nil {
									{ *t.AssignedUserID }
								} else {
									<span class="dash">—</span>
								}
							</td>
							<td>
								if t.ConvertedOrderCode != nil {
									<span class="mono">{ *t.ConvertedOrderCode }</span>
								} else {
									<span class="dash">—</span>
								}
							</td>
							<td class="num">
								if t.ConvertedRevenueVND != nil {
									{ formatVNDHelper(*t.ConvertedRevenueVND) }
								} else {
									<span class="dash">—</span>
								}
							</td>
							<td class="td-go">
								if t.Status != "converted" && t.Status != "skipped" {
									<button
										class="btn btn--ghost"
										hx-get={ "/campaigns/" + campaignID + "/targets/" + t.PartyID + "/modal/convert" }
										hx-target="#modal"
										hx-swap="innerHTML"
									>Ghi convert</button>
									<button
										class="btn btn--ghost"
										hx-patch={ "/campaigns/" + campaignID + "/targets/" + t.PartyID + "/status" }
										hx-vals={ `{"status":"skipped"}` }
										hx-target={ "#target-" + t.PartyID }
										hx-swap="outerHTML"
									>Skip</button>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// CampaignTargetRow renders a single target row (HTMX swap after status update).
templ CampaignTargetRow(campaignID string, t domain.CampaignTarget, partyNames map[string]string) {
	<tr id={ "target-" + t.PartyID }>
		<td>
			<a class="cell-strong" href={ templ.SafeURL("/customers/" + t.PartyID) }>
				{ partyDisplayName(partyNames, t.PartyID) }
			</a>
		</td>
		<td>
			<span class={ "bdg " + targetStatusBdg(t.Status) }>
				<span class="bdg__dot"></span>
				{ t.Status }
			</span>
		</td>
		<td class="muted">
			if t.AssignedUserID != nil {
				{ *t.AssignedUserID }
			} else {
				<span class="dash">—</span>
			}
		</td>
		<td>
			if t.ConvertedOrderCode != nil {
				<span class="mono">{ *t.ConvertedOrderCode }</span>
			} else {
				<span class="dash">—</span>
			}
		</td>
		<td class="num">
			if t.ConvertedRevenueVND != nil {
				{ formatVNDHelper(*t.ConvertedRevenueVND) }
			} else {
				<span class="dash">—</span>
			}
		</td>
		<td></td>
	</tr>
}

// ── pure helpers ──────────────────────────────────────────────────────────────

// campaignStatusBdg maps a campaign status to a bdg modifier class.
func campaignStatusBdg(status string) string {
	switch status {
	case "running":
		return "bdg--good"
	case "done":
		return "bdg--accent"
	default: // draft
		return ""
	}
}

// targetStatusBdg maps a target status to a bdg modifier class.
func targetStatusBdg(status string) string {
	switch status {
	case "converted":
		return "bdg--good"
	case "skipped":
		return "bdg--bad"
	case "sent":
		return "bdg--accent"
	case "responded":
		return "bdg--warn"
	default: // queued
		return ""
	}
}

func partyDisplayName(names map[string]string, partyID string) string {
	if n, ok := names[partyID]; ok && n != "" {
		return n
	}
	return partyID
}
