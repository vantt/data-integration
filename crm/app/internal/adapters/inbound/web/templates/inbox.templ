package templates

import (
	"fmt"
	"github.com/vantt/data-integration/crm/app/internal/domain"
)

// InboxPage renders S05 — Inbox (Conversations).
templ InboxPage(convs []domain.Conversation, partyNames map[string]string, statusFilter, assigneeFilter string) {
	@AppShell("S05", "Hộp thư") {
		@Topbar("Hộp thư") {
			<div class="topbar-actions">
				<select
					name="status"
					class="form-control form-control-sm"
					hx-get="/inbox"
					hx-target="body"
					hx-push-url="true"
					hx-include="[name='assignee']"
				>
					<option value="" selected?={ statusFilter == "" }>Tất cả</option>
					<option value="open" selected?={ statusFilter == "open" }>Đang mở</option>
					<option value="pending" selected?={ statusFilter == "pending" }>Chờ xử lý</option>
					<option value="closed" selected?={ statusFilter == "closed" }>Đã đóng</option>
				</select>
			</div>
		}
		<div class="page-content">
			if len(convs) == 0 {
				@inboxEmpty()
			} else {
				<div class="conv-list">
					for _, c := range convs {
						@convRow(c, partyNames)
					}
				</div>
			}
		</div>
		@modalContainer()
	}
}

// convRow renders one conversation row in the inbox list.
templ convRow(c domain.Conversation, partyNames map[string]string) {
	<div class="conv-row" id={ "conv-" + c.ConversationID }>
		<a href={ templ.SafeURL("/inbox/" + c.ConversationID) } class="conv-row-link">
			<div class="conv-row-header">
				<span class="conv-party-name">
					if c.PartyID != nil {
						{ partyNames[*c.PartyID] }
					} else {
						<span class="badge-pill badge-amber">Chưa link khách</span>
					}
				</span>
				<span class={ "badge-pill " + convStatusClass(c.Status) }>{ c.Status }</span>
				if c.UnreadCount > 0 {
					<span class="badge-unread">{ fmt.Sprintf("%d", c.UnreadCount) }</span>
				}
			</div>
			<div class="conv-row-meta text-muted">
				<span>{ c.Channel }</span>
				if c.LastMessageAt != nil {
					<span>· { formatICTHelper(*c.LastMessageAt) }</span>
				}
			</div>
		</a>
	</div>
}

templ inboxEmpty() {
	<div class="empty-state">
		<div class="empty-state-icon">💬</div>
		<div class="empty-state-title">Không có hội thoại nào</div>
		<div class="empty-state-desc">Chưa có tin nhắn inbound nào trong filter này.</div>
	</div>
}

// ── local helpers ─────────────────────────────────────────────────────────────

func convStatusClass(status string) string {
	switch status {
	case "open":
		return "badge-active"
	case "pending":
		return "badge-amber"
	case "closed":
		return "badge-silver"
	default:
		return "badge-silver"
	}
}
