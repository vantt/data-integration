package templates

import (
	"fmt"
	"github.com/vantt/data-integration/crm/app/internal/domain"
)

// InboxPage renders S05 — Inbox (Conversations).
templ InboxPage(convs []domain.Conversation, partyNames map[string]string, statusFilter, assigneeFilter string) {
	@AppShell("S05", "Hộp thư") {
		<div class="crm-page page-enter">
			<div class="crm-pagehead">
				<div>
					<div class="caption crm-pagehead__eyebrow">HỘP THƯ</div>
					<h1 class="crm-pagehead__title">Hộp thư</h1>
				</div>
				<div class="crm-pagehead__aside">
					<button class="btn btn--secondary">Gán cho tôi</button>
				</div>
			</div>
			<div class="toolbar">
				<div class="toolbar__filters">
					<div class="fsel">
						<span class="fsel__label caption">Trạng thái</span>
						<div class="fsel__field">
							<select
								name="status"
								hx-get="/inbox"
								hx-target="body"
								hx-push-url="true"
								hx-include="[name='assignee']"
							>
								<option value="" selected?={ statusFilter == "" }>Tất cả</option>
								<option value="open" selected?={ statusFilter == "open" }>Đang mở</option>
								<option value="pending" selected?={ statusFilter == "pending" }>Chờ xử lý</option>
								<option value="closed" selected?={ statusFilter == "closed" }>Đã đóng</option>
							</select>
							<span class="fsel__chev">@Icon("chevdown", 12)</span>
						</div>
					</div>
				</div>
			</div>
			<div class="inbox-grid">
				if len(convs) == 0 {
					<div class="conv-list">
						<div class="state">
							<div class="state__inner">
								<div class="state__title">Không có hội thoại nào</div>
								<p class="state__sub">Chưa có tin nhắn inbound nào trong filter này.</p>
							</div>
						</div>
					</div>
				} else {
					<div class="conv-list">
						for _, c := range convs {
							@convRow(c, partyNames)
						}
					</div>
				}
				<div class="preview-pane">
					<div class="state">
						<div class="state__inner">
							<div class="state__title">Chọn một hội thoại</div>
							<p class="state__sub">Chọn hội thoại bên trái để xem trước nội dung.</p>
						</div>
					</div>
				</div>
			</div>
			@modalContainer()
		</div>
	}
}

// convRow renders one conversation row in the inbox list.
templ convRow(c domain.Conversation, partyNames map[string]string) {
	<a
		href={ templ.SafeURL("/inbox/" + c.ConversationID) }
		class="conv-row"
		id={ "conv-" + c.ConversationID }
	>
		<span
			class={ "conv-row__unread" + func() string {
				if c.UnreadCount == 0 {
					return " conv-row__unread--none"
				}
				return ""
			}() }
		></span>
		<div class="conv-row__main">
			<div class="conv-row__name">
				if c.PartyID != nil {
					<b>{ partyNames[*c.PartyID] }</b>
					<span class="bdg bdg--good">Đã link</span>
				} else {
					<span class="psid-mono">{ c.ExternalThreadID }</span>
					<span class="bdg bdg--warn">Chưa link khách</span>
				}
			</div>
			<div class="conv-row__prev">
				<span class={ "bdg " + convStatusBdgClass(c.Status) }>{ c.Status }</span>
				<span class="mono">{ c.Channel }</span>
			</div>
		</div>
		<div class="conv-row__time">
			if c.LastMessageAt != nil {
				{ formatICTHelper(*c.LastMessageAt) }
			}
			if c.UnreadCount > 0 {
				<br/>
				<span class="crm-nav__badge crm-nav__badge--warn">{ fmt.Sprintf("%d", c.UnreadCount) }</span>
			}
		</div>
	</a>
}

// ── modal container (shared slot for all HTMX-loaded modals) ──────────────────

// ── local helpers ─────────────────────────────────────────────────────────────

func convStatusClass(status string) string {
	switch status {
	case "open":
		return "badge-active"
	case "pending":
		return "badge-amber"
	case "closed":
		return "badge-silver"
	default:
		return "badge-silver"
	}
}

func convStatusBdgClass(status string) string {
	switch status {
	case "open":
		return "bdg--good"
	case "pending":
		return "bdg--warn"
	case "closed":
		return ""
	default:
		return ""
	}
}
