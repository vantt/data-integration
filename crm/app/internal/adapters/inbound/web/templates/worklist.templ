package templates

import (
	"fmt"
	"github.com/vantt/data-integration/crm/app/internal/domain"
)

// WorklistPage renders S01 — Worklist / Dashboard.
templ WorklistPage(actions []domain.ActionQueueItem, tasks []domain.Task, refreshedAt string, isStale bool) {
	@AppShell("S01", "Worklist") {
		<div class="crm-page page-enter">
			<div class="crm-pagehead">
				<div>
					<div class="caption crm-pagehead__eyebrow">WORKLIST</div>
					<h1 class="crm-pagehead__title">Worklist hôm nay</h1>
				</div>
				<div class="crm-pagehead__aside">
					<button
						class="btn btn--secondary"
						hx-get="/worklist/fragment"
						hx-target="#worklist-container"
						hx-swap="outerHTML"
						hx-indicator="#refresh-spinner"
					>
						<span id="refresh-spinner" class="htmx-indicator spinner"></span>
						@Icon("refresh", 13)
						Làm mới
					</button>
				</div>
			</div>
			<div id="worklist-container">
				@WorklistFragment(actions, tasks, refreshedAt, isStale)
			</div>
		</div>
	}
}

// WorklistFragment is the HTMX-refreshable inner fragment (also served at GET /worklist/fragment).
templ WorklistFragment(actions []domain.ActionQueueItem, tasks []domain.Task, refreshedAt string, isStale bool) {
	<div id="worklist-container">
		if len(actions) == 0 && len(tasks) == 0 {
			@worklistEmpty()
		} else {
			if len(actions) > 0 {
				@actionQueueSection(actions)
			}
			if len(tasks) > 0 {
				@taskListWidget(tasks)
			}
		}
		@FreshnessBadge(refreshedAt, isStale)
	</div>
}

// FreshnessBadge shows when the cache was last refreshed.
templ FreshnessBadge(refreshedAt string, isStale bool) {
	if isStale {
		<div class="caveat caveat--warn">
			<span class="caveat__mark">@Icon("warn", 13)</span>
			if refreshedAt == "" {
				Cache chưa có dữ liệu — chạy sync để cập nhật.
			} else {
				Cache cũ (cập nhật lúc { refreshedAt }) — đã quá 24h.
			}
		</div>
	} else {
		<div class="caveat caveat--info">
			<span class="caveat__mark">@Icon("clock", 13)</span>
			if refreshedAt == "" {
				Cache chưa có dữ liệu — chạy sync để cập nhật.
			} else {
				Cache cập nhật lúc { refreshedAt }
			}
		</div>
	}
}

// ── private sub-templates ──────────────────────────────────────────────────────

// actionQueueSection renders the action queue as DS aq-cards.
templ actionQueueSection(actions []domain.ActionQueueItem) {
	<div class="dash-card">
		<div class="dash-card__head">
			<div>
				<div class="dash-card__title">Hàng đợi hành động</div>
				<div class="dash-card__sub">từ kho dữ liệu</div>
			</div>
		</div>
		<div>
			for _, a := range actions {
				<div class="aq-card aq-card--compact">
					<div class="aq-card__top">
						<span class={ "chip " + actionTypeBadgeClassHelper(a.ActionType) }>{ a.ActionType }</span>
						<span class="aq-card__val">
							@Icon("money", 13)
							{ formatVNDHelper(a.ValueAtStakeVND) }
						</span>
					</div>
					<div class="aq-card__rationale">{ truncStr(a.RationaleVI, 80) }</div>
					<div class="aq-card__foot">
						if a.PartyID != nil {
							<a
								href={ templ.SafeURL("/customers/" + *a.PartyID) }
								class="btn btn--secondary aq-card__cta"
							>
								{ customerLabelHelper(a.CustomerName, a.CustomerKey) } — Mở hồ sơ
								@Icon("chevron", 12)
							</a>
						} else {
							<a
								href={ templ.SafeURL(fmt.Sprintf("/customers?q=%s", a.CustomerKey)) }
								class="btn btn--secondary aq-card__cta"
							>
								{ customerLabelHelper(a.CustomerName, a.CustomerKey) } — Mở hồ sơ
								@Icon("chevron", 12)
							</a>
						}
					</div>
				</div>
			}
		</div>
	</div>
}

// taskListWidget renders assigned tasks as DS wl-row items.
templ taskListWidget(tasks []domain.Task) {
	<div class="wl-list">
		for _, t := range tasks {
			<div class={ wlTaskRowClass(t.Status) } id={ "task-" + t.TaskID }>
				<button
					class={ wlCheckClass(t.Status) }
					hx-patch={ "/tasks/" + t.TaskID + "/done" }
					hx-target={ "#task-" + t.TaskID }
					hx-swap="outerHTML"
					aria-label="done"
				>
					if t.Status == "done" {
						@Icon("check", 13)
					}
				</button>
				<div class="wl-row__main">
					<div class="wl-row__top">
						<span class={ "chip " + taskStatusChipClass(t.Status) }>{ t.Status }</span>
						if t.PartyID != nil {
							<a class="wl-row__name" href={ templ.SafeURL("/customers/" + *t.PartyID) }>{ t.Title }</a>
						} else {
							<span class="wl-row__name">{ t.Title }</span>
						}
					</div>
					if t.Description != "" {
						<div class="wl-row__why">{ truncStr(t.Description, 80) }</div>
					}
					<div class="wl-row__meta">
						if t.DueAt != nil {
							<span class="wl-row__due">
								@Icon("clock", 11)
								Due: { formatICTHelper(*t.DueAt) }
							</span>
						}
					</div>
				</div>
				<div class="wl-row__aside">
					if t.PartyID != nil {
						<a href={ templ.SafeURL("/customers/" + *t.PartyID) } class="btn btn--ghost">
							Mở hồ sơ
							@Icon("chevron", 12)
						</a>
					}
				</div>
			</div>
		}
	</div>
}

templ worklistEmpty() {
	<div class="state">
		<div class="state__inner">
			<div class="state__title">Không có việc cần làm hôm nay</div>
			<div class="state__sub">
				Chưa có hành động nào từ kho dữ liệu.<br/>
				Hãy duyệt danh sách khách hàng hoặc chờ sync tiếp theo.
			</div>
			<div class="state__actions">
				<a href="/customers" class="btn btn--secondary">Duyệt khách hàng</a>
			</div>
		</div>
	</div>
}

// ── local pure helpers ─────────────────────────────────────────────────────────

func wlTaskRowClass(status string) string {
	if status == "done" || status == "cancelled" {
		return "wl-row wl-row--done"
	}
	return "wl-row"
}

func wlCheckClass(status string) string {
	if status == "done" {
		return "wl-check wl-check--on"
	}
	return "wl-check"
}

// taskStatusChipClass maps task status to a chip tone modifier.
func taskStatusChipClass(status string) string {
	switch status {
	case "done":
		return "chip--moss"
	case "cancelled":
		return "chip--coral"
	default:
		return "chip--amber"
	}
}
