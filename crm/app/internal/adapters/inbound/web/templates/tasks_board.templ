package templates

import (
	"fmt"
	"github.com/vantt/data-integration/crm/app/internal/domain"
)

// TasksBoardPage renders S07 — Tasks Board.
templ TasksBoardPage(grouped map[string][]domain.Task, assigneeFilter, statusFilter string) {
	@AppShell("S07", "Tasks") {
		<div class="crm-page page-enter">
			<div class="crm-pagehead">
				<div>
					<div class="caption crm-pagehead__eyebrow">TASKS</div>
					<h1 class="crm-pagehead__title">Bảng công việc</h1>
				</div>
				<div class="crm-pagehead__aside">
					<div class="chips">
						<button class="fchip fchip--on">Board</button>
						<button class="fchip">List</button>
					</div>
					<button
						class="btn btn--primary"
						hx-get="/tasks/modal/create"
						hx-target="#modal"
						hx-swap="innerHTML"
					>
						@Icon("plus", 14)
						Tạo task
					</button>
				</div>
			</div>
			<div class="toolbar">
				<div class="toolbar__filters">
					<div class="fsel">
						<span class="fsel__label caption">Trạng thái</span>
						<div class="fsel__field">
							<select
								name="status"
								hx-get="/tasks"
								hx-target="body"
								hx-push-url="true"
								hx-include="[name='assignee']"
							>
								<option value="" selected?={ statusFilter == "" }>Tất cả trạng thái</option>
								<option value="open" selected?={ statusFilter == "open" }>Open</option>
								<option value="doing" selected?={ statusFilter == "doing" }>Doing</option>
								<option value="done" selected?={ statusFilter == "done" }>Done</option>
								<option value="cancelled" selected?={ statusFilter == "cancelled" }>Cancelled</option>
							</select>
							<span class="fsel__chev">@Icon("chevdown", 12)</span>
						</div>
					</div>
				</div>
			</div>
			if isBoardEmpty(grouped) {
				@tasksBoardEmptyState()
			} else {
				<div class="board">
					@kanbanColumn("open", "OPEN", grouped["open"])
					@kanbanColumn("doing", "DOING", grouped["doing"])
					@kanbanColumn("done", "DONE", grouped["done"])
					@kanbanColumn("cancelled", "CANCELLED", grouped["cancelled"])
				</div>
			}
			@modalContainer()
		</div>
	}
}

// kanbanColumn renders one status column of the tasks board.
templ kanbanColumn(status, label string, tasks []domain.Task) {
	<div class="board-col">
		<div class="board-col__head">
			<span class="board-col__name">{ label }</span>
			<span class="board-col__count">{ fmt.Sprintf("%d", len(tasks)) }</span>
		</div>
		<div class="board-col__body">
			if len(tasks) == 0 {
				<div class="board-col__empty mono">—</div>
			} else {
				for _, t := range tasks {
					@taskCard(t)
				}
			}
		</div>
	</div>
}

// taskCard renders one task card in a kanban column.
templ taskCard(t domain.Task) {
	<div
		class="tcard"
		id={ "task-card-" + t.TaskID }
		draggable="true"
	>
		<div class="tcard__top">
			if t.Source == "action_queue" {
				<span class="auto-tag">AUTO</span>
			}
			<span class={ "bdg " + taskStatusClassHelper(t.Status) }>{ t.Status }</span>
		</div>
		<div class="tcard__title">{ t.Title }</div>
		if t.Description != "" {
			<div class="tcard__meta">{ truncStr(t.Description, 60) }</div>
		}
		<div class="tcard__meta">
			if t.PartyID != nil {
				<a href={ templ.SafeURL("/customers/" + *t.PartyID) } class="ghost-link">
					@Icon("user", 10)
					Hồ sơ
				</a>
			}
			if t.DueAt != nil {
				<span>
					@Icon("clock", 10)
					{ formatICTHelper(*t.DueAt) }
				</span>
			}
		</div>
		<div class="tcard__meta">
			if t.Status != "done" && t.Status != "cancelled" {
				<button
					class="ghost-link"
					hx-patch={ "/tasks/" + t.TaskID + "/status" }
					hx-vals={ `{"status":"done"}` }
				>
					@Icon("check", 10)
					Done
				</button>
			}
			if t.Status == "open" {
				<button
					class="ghost-link"
					hx-patch={ "/tasks/" + t.TaskID + "/status" }
					hx-vals={ `{"status":"doing"}` }
				>
					@Icon("chevron", 10)
					Doing
				</button>
			}
		</div>
	</div>
}

templ tasksBoardEmptyState() {
	<div class="state">
		<div class="state__inner">
			<div class="state__title">Không có task nào</div>
			<p class="state__sub">Hãy tạo task mới hoặc lọc theo tiêu chí khác.</p>
			<div class="state__actions">
				<button
					class="btn btn--primary"
					hx-get="/tasks/modal/create"
					hx-target="#modal"
					hx-swap="innerHTML"
				>
					@Icon("plus", 14)
					Tạo task mới
				</button>
			</div>
		</div>
	</div>
}

// isBoardEmpty returns true when all columns are empty.
func isBoardEmpty(grouped map[string][]domain.Task) bool {
	for _, tasks := range grouped {
		if len(tasks) > 0 {
			return false
		}
	}
	return true
}
