package templates

// Icon renders a Precision inline SVG glyph (16px box, 1.3 stroke, round
// caps, currentColor). Ported from the design-system Icon set. Use a 1:1
// name from the prototype; redraw new glyphs in the same hand if needed.
//
//	@Icon("phone", 14)
templ Icon(name string, size int) {
	<svg
		class="ico"
		width={ itoa(size) }
		height={ itoa(size) }
		viewBox="0 0 16 16"
		fill="none"
		stroke="currentColor"
		stroke-width="1.3"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		switch name {
			case "worklist":
				<path d="M3 2.5h7l3 3v8H3z"></path>
				<path d="M9.5 2.5v3.5H13"></path>
				<path d="M5.5 9h5M5.5 11.3h3"></path>
			case "customers":
				<circle cx="6" cy="6" r="2.4"></circle>
				<path d="M2.3 13c.4-2.2 2-3.4 3.7-3.4S9.3 10.8 9.7 13"></path>
				<path d="M10.4 4.2a2.2 2.2 0 0 1 0 4.2M11.4 9.7c1.4.3 2.4 1.4 2.7 3.1"></path>
			case "inbox":
				<path d="M2 4.5 8 8.5l6-4"></path>
				<rect x="2" y="3" width="12" height="10" rx="1.5"></rect>
			case "tasks":
				<rect x="2.5" y="2.5" width="11" height="11" rx="1.5"></rect>
				<path d="M5.2 8l1.8 1.8L11 6"></path>
			case "segments":
				<circle cx="8" cy="8" r="5.5"></circle>
				<path d="M8 8 8 2.5M8 8l4.8 2.7"></path>
			case "campaigns":
				<path d="M2.5 6.5 12 3v8L2.5 9.5z"></path>
				<path d="M2.5 6.5v3M5 9.8v2.7h2V10.4"></path>
			case "ads":
				<path d="M2.5 11V8M6 11V5M9.5 11V6.5M13 11V3.5"></path>
			case "dedup":
				<circle cx="6" cy="8" r="3.2"></circle>
				<circle cx="10" cy="8" r="3.2"></circle>
			case "settings":
				<circle cx="8" cy="8" r="2"></circle>
				<circle cx="8" cy="8" r="5.4"></circle>
				<path d="M8 1.4v1.2M8 13.4v1.2M14.6 8h-1.2M2.6 8H1.4"></path>
			case "search":
				<circle cx="7" cy="7" r="4.5"></circle>
				<path d="M10.5 10.5 14 14"></path>
			case "plus":
				<path d="M8 3v10M3 8h10"></path>
			case "back":
				<path d="M9.5 3.5 5 8l4.5 4.5"></path>
			case "chevron":
				<path d="M6 4l4 4-4 4"></path>
			case "chevdown":
				<path d="M4 6l4 4 4-4"></path>
			case "close":
				<path d="M4 4l8 8M12 4l-8 8"></path>
			case "check":
				<path d="M3.5 8.5 6.5 11.5 12.5 5"></path>
			case "phone":
				<path d="M5.2 2.8 6.6 5 5.4 6.4a8 8 0 0 0 4.2 4.2L11 9.4l2.2 1.4c.4.3.5.8.2 1.2-1 1.4-2.8 1.8-5 .8A12 12 0 0 1 3.2 7C2.2 4.8 2.6 3 4 2c.4-.3.9-.2 1.2.2z"></path>
			case "edit":
				<path d="M10.5 2.8 13.2 5.5 5.5 13.2 2.8 13.8 3.4 11z"></path>
			case "trash":
				<path d="M3.5 4.5h9M6 4.5V3h4v1.5M5 4.5l.6 8.5h4.8L11 4.5"></path>
			case "tag":
				<path d="M2.5 2.5h5L13 8l-5 5-5.5-5.5z"></path>
				<circle cx="5.2" cy="5.2" r=".9"></circle>
			case "filter":
				<path d="M2.5 3.5h11L9.3 8.3v4l-2.6 1.3v-5.3z"></path>
			case "clock":
				<circle cx="8" cy="8" r="5.5"></circle>
				<path d="M8 5v3l2 1.4"></path>
			case "money":
				<circle cx="8" cy="8" r="5.5"></circle>
				<path d="M8 5v6M6.4 6.4h2.4a1.1 1.1 0 0 1 0 2.2H6.6h2.2a1.1 1.1 0 0 1 0 2.2H6.4"></path>
			case "user":
				<circle cx="8" cy="5.5" r="2.6"></circle>
				<path d="M3.2 13.2c.5-2.6 2.4-4 4.8-4s4.3 1.4 4.8 4"></path>
			case "merge":
				<path d="M5 2.5v3.2c0 1.2.8 2 2 2.3l2 .6c1.2.3 2 1.1 2 2.3v.6M5 2.5 3.5 4M5 2.5 6.5 4M11 11.5 9.5 13M11 11.5l1.5 1.5"></path>
			case "link":
				<path d="M6.5 9.5 9.5 6.5M5.5 7 4 8.5a2.1 2.1 0 0 0 3 3L8.5 10M10.5 9 12 7.5a2.1 2.1 0 0 0-3-3L7.5 6"></path>
			case "doc":
				<path d="M4 2.5h5L12 5.5v8H4z"></path>
				<path d="M8.5 2.5V6H12"></path>
			case "warn":
				<path d="M8 2.5 14 13H2z"></path>
				<path d="M8 6.5v3M8 11.2v.1"></path>
			case "bolt":
				<path d="M8.5 2 4 9h3.2l-.7 5L12 7H8.8z"></path>
			case "dots":
				<circle cx="4" cy="8" r=".9"></circle>
				<circle cx="8" cy="8" r=".9"></circle>
				<circle cx="12" cy="8" r=".9"></circle>
			case "logout":
				<path d="M6 3.5H3.5v9H6M9 5.5 11.5 8 9 10.5M11.5 8H6"></path>
			case "external":
				<path d="M6 3.5H3.5v9h9V10M9.5 3.5H13v3.5M13 3.5 7.5 9"></path>
			case "copy":
				<rect x="5.5" y="5.5" width="7" height="7" rx="1"></rect>
				<path d="M3.5 9.5h-1v-7h7v1"></path>
			case "refresh":
				<path d="M13 8a5 5 0 1 1-1.5-3.5M13 2.5V5h-2.5"></path>
		}
	</svg>
}
