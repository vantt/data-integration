package templates

import (
	"fmt"
	"github.com/vantt/data-integration/crm/app/internal/domain"
)

// ── M09 Assign Conversation ───────────────────────────────────────────────────

// ModalAssignConversation renders M09 — assign or re-assign a conversation to a staff user.
templ ModalAssignConversation(convID string, conv *domain.Conversation, users []domain.AppUser) {
	<div class="modal-scrim" onclick="document.getElementById('modal').innerHTML=''" data-surface="M09">
		<div class="modal" role="dialog" aria-modal="true" onclick="event.stopPropagation()">
			<div class="modal__head">
				<div>
					<div class="modal__title">Gán NV xử lý</div>
				</div>
				<button class="icon-btn" onclick="document.getElementById('modal').innerHTML=''" aria-label="Đóng">
					@Icon("close", 14)
				</button>
			</div>
			<form
				hx-post={ "/inbox/" + convID + "/assign" }
				hx-target="#modal"
				hx-swap="innerHTML"
			>
				<div class="modal__body">
					if conv != nil && conv.AssigneeUserID != nil {
						<label class="field">
							<span class="field__label">NV HIỆN TẠI</span>
							<div class="fact__v">{ *conv.AssigneeUserID }</div>
						</label>
					}
					<label class="field">
						<span class="field__label">GÁN CHO<span class="field__req"> *</span></span>
						if len(users) == 0 {
							<div class="muted body-sm">Chưa có NV nào trong hệ thống.</div>
							<input type="hidden" name="assignee_user_id" value=""/>
						} else {
							<div class="inp-sel">
								<select name="assignee_user_id" required>
									<option value="">-- Chọn NV --</option>
									for _, u := range users {
										<option
											value={ u.UserID }
											selected?={ conv != nil && conv.AssigneeUserID != nil && *conv.AssigneeUserID == u.UserID }
										>{ u.FullName } ({ u.Role })</option>
									}
								</select>
								<span class="inp-sel__chev">@Icon("chevdown", 12)</span>
							</div>
						}
					</label>
				</div>
				<div class="modal__actions">
					<button type="button" class="btn btn--ghost" onclick="document.getElementById('modal').innerHTML=''">Hủy</button>
					<button type="submit" class="btn btn--primary">Gán</button>
				</div>
			</form>
		</div>
	</div>
}

// ── M10 Close Conversation ────────────────────────────────────────────────────

// ModalCloseConversation renders M10 — close a conversation with an optional result note.
templ ModalCloseConversation(convID string, conv *domain.Conversation) {
	<div class="modal-scrim" onclick="document.getElementById('modal').innerHTML=''" data-surface="M10">
		<div class="modal" role="dialog" aria-modal="true" onclick="event.stopPropagation()">
			<div class="modal__head">
				<div>
					<div class="modal__title">Đóng hội thoại</div>
				</div>
				<button class="icon-btn" onclick="document.getElementById('modal').innerHTML=''" aria-label="Đóng">
					@Icon("close", 14)
				</button>
			</div>
			<form
				hx-post={ "/inbox/" + convID + "/close" }
				hx-target="#modal"
				hx-swap="innerHTML"
			>
				<div class="modal__body">
					<label class="field">
						<span class="field__label">KẾT QUẢ XỬ LÝ</span>
						<textarea name="result" class="inp inp--area" rows="3" placeholder="Đã giải quyết thắc mắc về đơn hàng..."></textarea>
					</label>
					if conv != nil && conv.PartyID != nil {
						<label class="chk-row">
							<span class="chk-box chk-box--on">@Icon("check", 12)</span>
							<span class="chk-row__text">Ghi vào activity timeline của khách (type=chat).</span>
							<input type="checkbox" name="log_activity" value="1" checked class="sr-only"/>
						</label>
					}
				</div>
				<div class="modal__actions">
					<button type="button" class="btn btn--ghost" onclick="document.getElementById('modal').innerHTML=''">Hủy</button>
					<button type="submit" class="btn btn--primary">Đóng hội thoại</button>
				</div>
			</form>
		</div>
	</div>
}

// ── M11 Link Party to Conversation ───────────────────────────────────────────

// ModalLinkParty renders M11 — search and link a party to a conversation.
templ ModalLinkParty(convID string, conv *domain.Conversation) {
	<div class="modal-scrim" onclick="document.getElementById('modal').innerHTML=''" data-surface="M11">
		<div class="modal" role="dialog" aria-modal="true" onclick="event.stopPropagation()">
			<div class="modal__head">
				<div>
					<div class="modal__title">Gắn khách vào hội thoại</div>
					if conv != nil {
						<div class="modal__sub">Tìm khách cho: { conv.ConversationID }</div>
					}
				</div>
				<button class="icon-btn" onclick="document.getElementById('modal').innerHTML=''" aria-label="Đóng">
					@Icon("close", 14)
				</button>
			</div>
			<div class="modal__body">
				<label class="field">
					<input
						type="search"
						class="inp"
						placeholder="Tìm theo SĐT, tên, email..."
						name="q"
						hx-get={ "/inbox/" + convID + "/parties/search" }
						hx-target="#party-search-results"
						hx-trigger="input changed delay:300ms"
					/>
				</label>
				<div id="party-search-results"></div>
			</div>
			<div class="modal__actions">
				<button type="button" class="btn btn--ghost" onclick="document.getElementById('modal').innerHTML=''">Hủy</button>
			</div>
		</div>
	</div>
}

// PartySearchResults renders the live search results inside M11.
// convID is required to build the correct hx-post URL for link-party.
templ PartySearchResults(parties []domain.Party, convID string) {
	if len(parties) == 0 {
		<div class="muted body-sm">Không tìm thấy khách hàng nào.</div>
	} else {
		<div class="cand-list">
			for _, p := range parties {
				<div class="cand-row">
					<div class="row-between">
						<span class="cell-strong">{ p.DisplayName }</span>
						<span class="mono muted">{ p.PrimaryPhone }</span>
					</div>
					<form hx-post={ "/inbox/" + convID + "/link-party" }>
						<input type="hidden" name="party_id" value={ p.PartyID }/>
						<button type="submit" class="btn btn--secondary">Chọn</button>
					</form>
				</div>
			}
		</div>
	}
}

// ── M08 Log Activity ──────────────────────────────────────────────────────────

// ModalLogActivity renders M08 — log an activity for a party.
// convID may be empty when invoked from Customer 360 (not a conversation context).
templ ModalLogActivity(partyID, convID string) {
	<div class="modal-scrim" onclick="document.getElementById('modal').innerHTML=''" data-surface="M08">
		<div class="modal" role="dialog" aria-modal="true" onclick="event.stopPropagation()">
			<div class="modal__head">
				<div>
					<div class="modal__title">Ghi log hoạt động</div>
				</div>
				<button class="icon-btn" onclick="document.getElementById('modal').innerHTML=''" aria-label="Đóng">
					@Icon("close", 14)
				</button>
			</div>
			<form
				hx-post={ logActivityPostURL(partyID, convID) }
				hx-target="#modal"
				hx-swap="innerHTML"
			>
				<input type="hidden" name="party_id" value={ partyID }/>
				<div class="modal__body">
					<label class="field">
						<span class="field__label">LOẠI<span class="field__req"> *</span></span>
						<div class="radioset">
							<label class="radio-pill radio-pill--on">
								<span class="radio-pill__dot"></span>
								<input type="radio" name="activity_type" value="call" checked class="sr-only"/>
								Cuộc gọi
							</label>
							<label class="radio-pill">
								<span class="radio-pill__dot"></span>
								<input type="radio" name="activity_type" value="note" class="sr-only"/>
								Ghi chú
							</label>
							<label class="radio-pill">
								<span class="radio-pill__dot"></span>
								<input type="radio" name="activity_type" value="chat" class="sr-only"/>
								Chat
							</label>
							<label class="radio-pill">
								<span class="radio-pill__dot"></span>
								<input type="radio" name="activity_type" value="email" class="sr-only"/>
								Email
							</label>
						</div>
					</label>
					<label class="field">
						<span class="field__label">KẾT QUẢ / NỘI DUNG<span class="field__req"> *</span></span>
						<textarea name="body" class="inp inp--area" rows="4" placeholder="Khách xác nhận sẽ đặt tuần tới..." required></textarea>
					</label>
					<label class="field">
						<span class="field__label">ĐƠN LIÊN QUAN</span>
						<input type="text" name="related_order_code" class="inp inp--mono" placeholder="ORD-20060812"/>
						<span class="field__hint">(tùy chọn)</span>
					</label>
				</div>
				<div class="modal__actions">
					<button type="button" class="btn btn--ghost" onclick="document.getElementById('modal').innerHTML=''">Hủy</button>
					<button type="submit" class="btn btn--primary">Lưu</button>
				</div>
			</form>
		</div>
	</div>
}

// ── M05 Create Task ───────────────────────────────────────────────────────────

// ModalCreateTask renders M05 — create a new task.
templ ModalCreateTask(prefillPartyID string) {
	<div class="modal-scrim" onclick="document.getElementById('modal').innerHTML=''" data-surface="M05">
		<div class="modal" role="dialog" aria-modal="true" onclick="event.stopPropagation()">
			<div class="modal__head">
				<div>
					<div class="modal__title">Tạo task mới</div>
				</div>
				<button class="icon-btn" onclick="document.getElementById('modal').innerHTML=''" aria-label="Đóng">
					@Icon("close", 14)
				</button>
			</div>
			<form
				hx-post="/tasks"
				hx-target="#modal"
				hx-swap="innerHTML"
			>
				<div class="modal__body">
					<label class="field">
						<span class="field__label">TIÊU ĐỀ<span class="field__req"> *</span></span>
						<input type="text" name="title" class="inp" placeholder="Follow-up sau cuộc gọi" required/>
					</label>
					<label class="field">
						<span class="field__label">KHÁCH HÀNG (ID)</span>
						<input type="text" name="party_id" class="inp" value={ prefillPartyID } placeholder="party-uuid"/>
						<span class="field__hint">(tùy chọn)</span>
					</label>
					<div class="field-row">
						<label class="field">
							<span class="field__label">DUE DATE</span>
							<input type="date" name="due_at" class="inp inp--mono"/>
						</label>
						<label class="field">
							<span class="field__label">GIỜ</span>
							<input type="time" name="due_time" class="inp inp--mono" defaultvalue="10:00"/>
						</label>
					</div>
					<label class="field">
						<span class="field__label">GHI CHÚ</span>
						<textarea name="description" class="inp inp--area" rows="2" placeholder="Chi tiết..."></textarea>
					</label>
				</div>
				<div class="modal__actions">
					<button type="button" class="btn btn--ghost" onclick="document.getElementById('modal').innerHTML=''">Hủy</button>
					<button type="submit" class="btn btn--primary">Lưu task</button>
				</div>
			</form>
		</div>
	</div>
}

// ── M01 Merge Confirm ─────────────────────────────────────────────────────────

// ModalMergeConfirm renders M01 — confirm party merge (Party B → Party A).
templ ModalMergeConfirm(cand *domain.DedupCandidate, partyA, partyB *domain.Party) {
	<div class="modal-scrim" onclick="document.getElementById('modal').innerHTML=''" data-surface="M01">
		<div class="modal" role="dialog" aria-modal="true" onclick="event.stopPropagation()">
			<div class="modal__head">
				<div>
					<div class="modal__title">Xác nhận gộp khách</div>
					if partyA != nil && partyB != nil {
						<div class="modal__sub">Merge { partyB.DisplayName } → { partyA.DisplayName } (giữ lại)</div>
					}
				</div>
				<button class="icon-btn" onclick="document.getElementById('modal').innerHTML=''" aria-label="Đóng">
					@Icon("close", 14)
				</button>
			</div>
			<form
				hx-post={ "/dedup/" + cand.CandidateID + "/merge" }
				hx-target="#modal"
				hx-swap="innerHTML"
			>
				<div class="modal__body">
					<div class="dedup-compare">
						<div class="dedup-card dedup-card--survive">
							<span class="dedup-card__tag"><span class="bdg bdg--accent">GIỮ LẠI · A</span></span>
							if partyA != nil {
								<div class="mini-name">{ partyA.DisplayName }</div>
								<div class="facts">
									<div class="fact"><span class="fact__k">SĐT</span><span class="fact__v mono">{ partyA.PrimaryPhone }</span></div>
									<div class="fact"><span class="fact__k">Email</span><span class="fact__v">{ partyA.PrimaryEmail }</span></div>
								</div>
							} else {
								<div class="muted">Không tìm thấy</div>
							}
						</div>
						<div class="dedup-card">
							<span class="dedup-card__tag"><span class="bdg">GỘP VÀO · B</span></span>
							if partyB != nil {
								<div class="mini-name">{ partyB.DisplayName }</div>
								<div class="facts">
									<div class="fact"><span class="fact__k">SĐT</span><span class="fact__v mono">{ partyB.PrimaryPhone }</span></div>
									<div class="fact"><span class="fact__k">Email</span><span class="fact__v">{ partyB.PrimaryEmail }</span></div>
								</div>
							} else {
								<div class="muted">Không tìm thấy</div>
							}
						</div>
					</div>
					<div class="caveat caveat--info">
						Match rule: <strong>{ cand.MatchRule }</strong> · Score: { formatScore(cand.MatchScore) }
					</div>
					<div class="modal__note">
						@Icon("warn", 13)
						<div>
							<div>Sẽ chuyển tất cả đơn, activity, task sang Party A.</div>
							<div class="t-warn">Party B sẽ bị ẩn (is_merged=true).</div>
							<div class="t-good">Snapshot undo được lưu tự động (party_merge_log).</div>
						</div>
					</div>
					<label class="chk-row">
						<span class="chk-box" id="merge-chk-box"></span>
						<span class="chk-row__text">Tôi xác nhận muốn gộp 2 khách này.</span>
						<input type="checkbox" name="confirm" value="1" required class="sr-only"/>
					</label>
				</div>
				<div class="modal__actions">
					<button type="button" class="btn btn--ghost" onclick="document.getElementById('modal').innerHTML=''">Hủy</button>
					<button type="submit" class="btn btn--primary">
						@Icon("merge", 14)
						Xác nhận Merge
					</button>
				</div>
			</form>
		</div>
	</div>
}

// ── pure helpers ──────────────────────────────────────────────────────────────

func logActivityPostURL(partyID, convID string) string {
	if convID != "" {
		return "/inbox/" + convID + "/log-activity"
	}
	return "/customers/" + partyID + "/log-activity"
}

func formatScore(score float64) string {
	if score >= 1.0 {
		return "1.00"
	}
	s := fmt.Sprintf("%.2f", score)
	return s
}
