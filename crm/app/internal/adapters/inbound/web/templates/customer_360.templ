package templates

import (
	"fmt"
	"github.com/vantt/data-integration/crm/app/internal/domain"
)

// Customer360Page renders S03 — Customer 360 Detail.
templ Customer360Page(
	party *domain.Party360,
	identities []domain.PartyIdentity,
	activeTab string,
) {
	@AppShell("S03", party.DisplayName) {
		<div class="crm-page page-enter" data-surface="S03">
			<!-- c360-topbar: back · name + badges · action buttons -->
			<div class="c360-topbar">
				<a class="c360-back" href="/customers">
					@Icon("back", 13)
					Khách hàng
				</a>
				<div class="c360-id">
					<span class="c360-name">{ party.DisplayName }</span>
					<span class={ "bdg " + statusBadgeClassHelper(party.Status) }>{ party.Status }</span>
				</div>
				<div class="c360-actions">
					<button class="btn btn--secondary">@Icon("doc", 13) Ghi log</button>
					<button class="btn btn--secondary">@Icon("plus", 13) Task</button>
					<button class="btn btn--secondary">@Icon("user", 13) Gán NV</button>
					<button class="btn btn--secondary">@Icon("tag", 13) Tag</button>
				</div>
			</div>
			<!-- 2-column detail grid: tabs on left, info panel on right -->
			<div class="detail-grid">
				<!-- LEFT: tab bar + active panel -->
				<div class="detail-main">
					@c360TabBar(party.PartyID, activeTab)
					<div class="tabpanel">
						@c360ActivePanel(party.PartyID, activeTab)
					</div>
				</div>
				<!-- RIGHT: static info sidebar -->
				<aside class="detail-sidebar">
					@c360InfoCard(party, identities)
				</aside>
			</div>
		</div>
	}
}

// c360InfoCard renders the right-column sidebar party info.
templ c360InfoCard(party *domain.Party360, identities []domain.PartyIdentity) {
	<div class="scard">
		<div class="caption scard__eyebrow">THÔNG TIN CƠ BẢN</div>
		<div class="facts">
			<div class="fact">
				<span class="fact__k">Tên</span>
				<span class="fact__v">{ party.DisplayName }</span>
			</div>
			if party.PrimaryPhone != "" {
				<div class="fact">
					<span class="fact__k">SĐT</span>
					<span class="fact__v">
						<a href={ templ.SafeURL("tel:" + party.PrimaryPhone) } class="mono">{ party.PrimaryPhone }</a>
					</span>
				</div>
			}
			if party.PrimaryEmail != "" {
				<div class="fact">
					<span class="fact__k">Email</span>
					<span class="fact__v">{ party.PrimaryEmail }</span>
				</div>
			}
			if party.LifecycleStage != "" {
				<div class="fact">
					<span class="fact__k">Giai đoạn</span>
					<span class="fact__v">{ party.LifecycleStage }</span>
				</div>
			}
			<div class="fact">
				<span class="fact__k">Loại</span>
				<span class="fact__v">{ party.PartyType }</span>
			</div>
			if party.OwnerUserID != nil {
				<div class="fact">
					<span class="fact__k">Owner</span>
					<span class="fact__v">{ *party.OwnerUserID }</span>
				</div>
			}
		</div>
		<!-- Consent row -->
		<div class="consent-row">
			if party.ConsentContact != nil && *party.ConsentContact {
				<span class="consent-yes">@Icon("check", 13) Cho phép liên lạc</span>
			} else {
				<span class="consent-no">@Icon("close", 13) Không liên lạc</span>
			}
		</div>
	</div>
	<!-- Identities -->
	if len(identities) > 0 {
		<div class="scard">
			<div class="caption scard__eyebrow">ĐỊNH DANH</div>
			<div class="facts">
				for _, id := range identities {
					<div class="fact">
						<span class="fact__k">{ id.IdentityType }</span>
						<span class="fact__v mono">{ id.IdentityValue }</span>
					</div>
				}
			</div>
		</div>
	}
	<!-- Tags -->
	if party.TagsJSON != "" && party.TagsJSON != "[]" && party.TagsJSON != "null" {
		<div class="scard">
			<div class="caption scard__eyebrow">TAGS</div>
			<div class="chips">
				<span class="chip chip--amber">{ truncStr(party.TagsJSON, 40) }</span>
			</div>
		</div>
	}
	<!-- Timestamps -->
	<div class="scard">
		<div class="caption scard__eyebrow">THỜI GIAN</div>
		<div class="facts">
			<div class="fact">
				<span class="fact__k">Tạo lúc</span>
				<span class="fact__v muted">{ formatICTHelper(party.PartyCreatedAt) }</span>
			</div>
		</div>
	</div>
}

// c360TabBar renders the horizontal tab navigation.
templ c360TabBar(partyID string, activeTab string) {
	<div class="tabbar">
		@c360Tab(partyID, "insight", "Insight", activeTab)
		@c360Tab(partyID, "orders", "Đơn hàng", activeTab)
		@c360Tab(partyID, "timeline", "Timeline", activeTab)
		@c360Tab(partyID, "tasks", "Tasks", activeTab)
		@c360Tab(partyID, "notes", "Ghi chú", activeTab)
		@c360Tab(partyID, "chat", "Chat", activeTab)
	</div>
}

templ c360Tab(partyID, tab, label, activeTab string) {
	<a
		href={ templ.SafeURL(fmt.Sprintf("/customers/%s?tab=%s", partyID, tab)) }
		class="tab"
		if tab == activeTab {
			aria-selected="true"
		}
		hx-get={ fmt.Sprintf("/customers/%s/panels/%s", partyID, tab) }
		hx-target=".tabpanel"
		hx-swap="innerHTML"
		hx-push-url={ fmt.Sprintf("/customers/%s?tab=%s", partyID, tab) }
	>
		{ label }
	</a>
}

// c360ActivePanel renders the initially active panel on full-page load.
templ c360ActivePanel(partyID string, activeTab string) {
	<div
		hx-get={ fmt.Sprintf("/customers/%s/panels/%s", partyID, activeTab) }
		hx-trigger="load"
		hx-swap="outerHTML"
	>
		<div class="state">
			<div class="state__inner">
				<span class="spinner"></span>
			</div>
		</div>
	</div>
}

// ── Panel templates (returned as HTMX fragments) ───────────────────────────────

// P01InsightPanel renders the insight tab content.
templ P01InsightPanel(insight *domain.CacheInsight) {
	<div data-surface="P01">
	if insight == nil || insight.Insight == nil {
		<div class="state">
			<div class="state__inner">
				<div class="state__title">Chưa có dữ liệu phân tích</div>
				<div class="state__sub">
					Insight từ kho dữ liệu chưa được sync.<br/>
					Chạy reverse-ETL để cập nhật.
				</div>
			</div>
		</div>
	} else {
		<div class="stack stack-5">
			<!-- Action Queue -->
			if len(insight.Actions) > 0 {
				<div>
					<div class="panel-head">
						<span class="panel-title">Action queue</span>
						<span class="panel-sub">{ fmt.Sprintf("%d đề xuất", len(insight.Actions)) }</span>
					</div>
					<div class="stack stack-3">
						for _, a := range insight.Actions {
							<div class="aq-card">
								<div class="aq-card__top">
									<span class={ "chip " + actionTypeBadgeClassHelper(a.ActionType) }>{ a.ActionType }</span>
									<span class="aq-card__val">@Icon("money", 13) { formatVNDHelper(a.ValueAtStakeVND) }</span>
								</div>
								<div class="aq-card__rationale">{ a.RationaleVI }</div>
							</div>
						}
					</div>
				</div>
			} else {
				<div class="caveat caveat--info">Không có hành động đề xuất nào cho khách này.</div>
			}
			<!-- RFM block -->
			<div>
				<div class="panel-head">
					<span class="panel-title">RFM</span>
					<span class="panel-sub">{ insight.Insight.ValueGroup }</span>
				</div>
				<div class="rfm">
					<div class="rfm__cell">
						<div class="rfm__glyph">R</div>
						<div class="rfm__name">Recency</div>
						<div class="rfm__val">{ insight.Insight.PredictedNextPurchaseDate }</div>
					</div>
					<div class="rfm__cell">
						<div class="rfm__glyph">F</div>
						<div class="rfm__name">Frequency</div>
						<div class="rfm__val">{ fmt.Sprintf("%.0f ngày/đơn", insight.Insight.AvgDaysBetweenOrders) }</div>
					</div>
					<div class="rfm__cell">
						<div class="rfm__glyph">M</div>
						<div class="rfm__name">Monetary · LTV</div>
						<div class="rfm__val">{ formatVNDHelper(int64(insight.Insight.LifetimeContributionMargin)) }</div>
					</div>
				</div>
			</div>
			<!-- Signals -->
			<div>
				<div class="panel-head"><span class="panel-title">Signals</span></div>
				<div class="signal-grid">
					<div class="signal-cell">
						<div class="signal-cell__k">Customer status</div>
						<div class="signal-cell__v">
							<span class={ "bdg " + statusBadgeClassHelper(insight.Insight.CustomerStatus) }>{ insight.Insight.CustomerStatus }</span>
						</div>
					</div>
					<div class="signal-cell">
						<div class="signal-cell__k">Next purchase</div>
						<div class="signal-cell__v">{ insight.Insight.NextPurchaseSignal }</div>
					</div>
					if insight.Insight.TopAffinityProduct != "" {
						<div class="signal-cell">
							<div class="signal-cell__k">Top affinity</div>
							<div class="signal-cell__v">{ truncStr(insight.Insight.TopAffinityProduct, 30) }</div>
						</div>
					}
					<div class="signal-cell">
						<div class="signal-cell__k">Discount sensitivity</div>
						<div class="signal-cell__v">{ insight.Insight.DiscountSensitivity }</div>
					</div>
				</div>
			</div>
			@FreshnessBadge(insight.RefreshedAt, false)
		</div>
	}
	</div>
}

// P02OrderHistoryPanel renders the order history tab.
templ P02OrderHistoryPanel(orders []domain.RecentOrder) {
	<div data-surface="P02">
	if len(orders) == 0 {
		<div class="state">
			<div class="state__inner">
				<div class="state__title">Khách chưa có đơn hàng</div>
				<div class="state__sub">Dữ liệu đơn hàng chưa được sync từ kho.</div>
			</div>
		</div>
	} else {
		<div class="stack stack-4">
			<div class="tbl-wrap">
				<table class="tbl tbl--orders">
					<thead>
						<tr>
							<th>Mã đơn</th>
							<th>Ngày (ICT)</th>
							<th class="num-h">Doanh thu thuần</th>
							<th>Trạng thái</th>
							<th>Kênh</th>
							<th class="num-h">Số SP</th>
						</tr>
					</thead>
					<tbody>
						for _, o := range orders {
							<tr>
								<td class="mono cell-strong">
								<a href={ templ.SafeURL("/orders/" + o.OrderCode) } style="color:inherit;text-decoration:none;border-bottom:1px dotted var(--border-strong)">{ o.OrderCode }</a>
							</td>
								<td class="mono muted">{ formatDateKeyHelper(o.DateKey) }</td>
								<td class="num cell-strong">{ formatVNDHelper(o.NetRevenue) }</td>
								<td>{ o.Status }</td>
								<td class="muted">{ o.Channel }</td>
								<td class="num muted">{ fmt.Sprintf("%d", o.ItemCount) }</td>
							</tr>
						}
					</tbody>
					<tfoot>
						<tr>
							<td colspan="2">Tổng { fmt.Sprintf("%d", len(orders)) } đơn</td>
							<td class="num"></td>
							<td></td>
							<td></td>
							<td></td>
						</tr>
					</tfoot>
				</table>
			</div>
		</div>
	}
	</div>
}

// P03ActivityTimelinePanel renders the activity timeline tab.
// partyID is passed so the "Log activity" button can open the correct modal.
templ P03ActivityTimelinePanel(activities []domain.Activity, partyID string) {
	<div class="stack stack-4" data-surface="P03">
		<div class="panel-head">
			<span class="panel-title">Activity timeline</span>
			<button
				class="btn btn--secondary"
				hx-get={ fmt.Sprintf("/customers/%s/modal/log-activity", partyID) }
				hx-target="#modal"
				hx-swap="innerHTML"
			>
				@Icon("plus", 13) Ghi hoạt động
			</button>
		</div>
		if len(activities) == 0 {
			<div class="state">
				<div class="state__inner">
					<div class="state__title">Chưa có hoạt động nào</div>
					<div class="state__sub">Ghi log cuộc gọi, ghi chú, hoặc lần ghé thăm đầu tiên.</div>
				</div>
			</div>
		} else {
			<div class="timeline">
				for _, a := range activities {
					<div class={ "tl-item " + activityTypeTlClass(a.ActivityType) }>
						<div class="tl-time">
							{ formatICTHelper(a.OccurredAt) }
							<span class="tl-type">{ a.ActivityType }</span>
						</div>
						if a.Subject != "" {
							<div class="tl-title"><strong>{ a.Subject }</strong> — { a.Body }</div>
						} else {
							<div class="tl-title">{ a.Body }</div>
						}
					</div>
				}
			</div>
		}
	</div>
}

// P04TasksPanel renders the tasks tab for one party.
templ P04TasksPanel(tasks []domain.Task, partyID string) {
	<div class="stack stack-4" data-surface="P04">
		<div class="panel-head">
			<span class="panel-title">Tasks</span>
		</div>
		if len(tasks) == 0 {
			<div class="state">
				<div class="state__inner">
					<div class="state__title">Không có task nào</div>
					<div class="state__sub">Task sẽ hiển thị khi được tạo thủ công hoặc từ action queue.</div>
				</div>
			</div>
		} else {
			<div class="wl-list">
				for _, t := range tasks {
					<div class={ p04TaskRowClass(t.Status) } id={ "ptask-" + t.TaskID }>
						<input
							type="checkbox"
							class="wl-check"
							checked?={ t.Status == "done" }
							hx-patch={ "/tasks/" + t.TaskID + "/done" }
							hx-target={ "#ptask-" + t.TaskID }
							hx-swap="outerHTML"
						/>
						<div class="wl-row__main">
							<div class="wl-row__top">
								if t.Source == "action_queue" {
									<span class="auto-tag">AUTO</span>
								}
								<span class="wl-row__name">{ t.Title }</span>
							</div>
							<div class="wl-row__meta">
								<span class={ taskStatusClassHelper(t.Status) }>{ t.Status }</span>
								if t.DueAt != nil {
									<span class="wl-row__due">@Icon("clock", 11) Due: { formatICTHelper(*t.DueAt) }</span>
								}
								if t.AssigneeUserID != nil {
									<span class="muted">{ *t.AssigneeUserID }</span>
								}
							</div>
						</div>
					</div>
				}
			</div>
		}
	</div>
}

// P05NotesPanel renders the notes tab with an add-note form.
templ P05NotesPanel(notes []domain.Note, partyID string) {
	<div class="stack stack-4" data-surface="P05">
		<div class="panel-head">
			<span class="panel-title">Ghi chú</span>
		</div>
		<!-- Add note form -->
		<form
			hx-post={ fmt.Sprintf("/customers/%s/notes", partyID) }
			hx-target="#notes-list"
			hx-swap="afterbegin"
			hx-on::after-request="this.reset()"
		>
			<div class="field">
				<textarea
					class="inp inp--area"
					name="body"
					placeholder="Thêm ghi chú về khách hàng..."
					rows="3"
				></textarea>
			</div>
			<div class="row-flex">
				<button type="submit" class="btn btn--secondary">@Icon("plus", 13) Lưu ghi chú</button>
			</div>
		</form>
		<!-- Notes list -->
		<div id="notes-list">
			if len(notes) == 0 {
				<div class="state">
					<div class="state__inner">
						<div class="state__title">Chưa có ghi chú nào</div>
					</div>
				</div>
			} else {
				for _, n := range notes {
					@NoteCard(n)
				}
			}
		</div>
	</div>
}

// NoteCard renders one note — also used as the HTMX prepend fragment after POST.
templ NoteCard(n domain.Note) {
	<div class="note-card">
		<div class="note-card__head">
			<div class="note-card__who">
				if n.AuthorUserID != nil {
					{ *n.AuthorUserID }
				}
				<span class="note-card__when">{ formatICTHelper(n.CreatedAt) }</span>
			</div>
		</div>
		<div class="note-card__body">{ n.Body }</div>
	</div>
}

// ── helpers local to this file ─────────────────────────────────────────────────

func p04TaskRowClass(status string) string {
	if status == "done" || status == "cancelled" {
		return "wl-row wl-row--done"
	}
	return "wl-row"
}

func activityTypeTlClass(t string) string {
	switch t {
	case "chat":
		return "tl-item--good"
	case "note":
		return ""
	case "call":
		return ""
	default:
		return "tl-item--muted"
	}
}
