package templates

import (
	"fmt"
	"github.com/vantt/data-integration/crm/app/internal/domain"
)

// OrderItemsTab renders the Items tab (line items table).
// Returned as an HTMX fragment for /orders/{code}/tabs/items.
templ OrderItemsTab(o *domain.OrderDetail) {
	{{ items := o.LineItems }}
	{{ f := o.Financial }}
	<div class="tabpanel stack-4">
		<div class="panel-head">
			<span class="panel-title">Line items</span>
			<span class="panel-sub">fact_sales × dim_products</span>
		</div>
		if len(items) == 0 {
			<div class="ship-empty">
				<div class="ship-empty__title voice"><em>No line items</em></div>
				<p class="ship-empty__sub">No product data found for this order.</p>
			</div>
		} else {
			<div class="tbl-wrap">
				<table class="tbl">
					<thead>
						<tr>
							<th>SKU</th>
							<th>Product / Variant</th>
							<th>Brand</th>
							<th class="num-h">Qty</th>
							<th class="num-h">Line</th>
							<th class="num-h">Disc.</th>
							<th class="num-h">Wt (g)</th>
						</tr>
					</thead>
					<tbody>
						for _, item := range items {
							<tr>
								<td class="num" style="text-align:left">
									if item.SKU != "" {
										{ item.SKU }
									} else {
										{ "—" }
									}
								</td>
								<td class="cell-strong">
									{ item.ProductName }
									if item.VariantName != "" || item.Category != "" {
										<span class="cell-sub">
											{ joinNonEmpty([]string{item.VariantName, item.Category}, " · ") }
										</span>
									}
								</td>
								<td class="muted">
									if item.BrandName != "" {
										{ item.BrandName }
									} else {
										{ "—" }
									}
								</td>
								<td class="num">{ fmt.Sprintf("%d", item.Quantity) }</td>
								<td class="num cell-strong">{ formatVNDHelper(item.Revenue) }</td>
								<td class="num muted">
									if item.DiscountAmount != 0 {
										{ formatVNDHelper(item.DiscountAmount) }
									} else {
										<span class="dash">—</span>
									}
								</td>
								<td class="num muted">
									if item.WeightGrams != nil {
										{ fmt.Sprintf("%d", *item.WeightGrams) }
									} else {
										—
									}
								</td>
							</tr>
						}
					</tbody>
					<tfoot>
						{{ var sumLine int64 }}
						for _, item := range items {
							{{ sumLine += item.Revenue }}
						}
						{{ netRef := f.NetRevenue }}
						if f.IsUS {
							{{ netRef = f.USRevenueExclVAT }}
						}
						<tr>
							<td colspan="4">Σ line revenue</td>
							<td class="num cell-strong" colspan="3">
								{ formatVNDHelper(sumLine) }
								if netRef != 0 {
									if sumLine == netRef {
										<span class="bdg bdg--good">matches net</span>
									} else {
										{{ delta := sumLine - netRef }}
										{{ if delta < 0 { delta = -delta } }}
										<span class="bdg bdg--warn">Δ { formatVNDHelper(delta) }</span>
									}
								}
							</td>
						</tr>
					</tfoot>
				</table>
			</div>
			<div class="note-line">
				<span class="caveat__mark">ⓘ</span>
				<span>No per-line COGS — cost of goods is recorded at order level only.</span>
			</div>
		}
	</div>
}
