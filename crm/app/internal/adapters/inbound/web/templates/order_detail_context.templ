package templates

import (
	"github.com/vantt/data-integration/crm/app/internal/domain"
)

// OrderContextTab renders the Context tab (channel + staff two-column cards).
// Returned as an HTMX fragment for /orders/{code}/tabs/context.
templ OrderContextTab(o *domain.OrderDetail) {
	{{ ch := o.Channel }}
	{{ st := o.Staff }}
	<div class="tabpanel stack-4">
		<div class="panel-head">
			<span class="panel-title">Channel &amp; staff</span>
			<span class="panel-sub">dim_channels · dim_staff · dim_promotions</span>
		</div>
		<div class="kpi-grid" style="grid-template-columns:1fr 1fr;gap:var(--sp-4)">
			<!-- Channel card -->
			<div class="scard">
				<div class="caption scard__eyebrow" style="color:var(--accent)">CHANNEL</div>
				<div class="facts" style="margin-top:var(--sp-3)">
					if ch.ChannelName != "" || ch.ChannelCode != "" {
						<div class="fact">
							<span class="fact__k">Name</span>
							<span class="fact__v">{ joinNonEmpty([]string{ch.ChannelName, ch.ChannelCode}, " · ") }</span>
						</div>
					}
					if ch.ChannelCategory != "" || ch.ChannelFormat != "" {
						<div class="fact">
							<span class="fact__k">Category</span>
							<span class="fact__v">{ joinNonEmpty([]string{ch.ChannelCategory, ch.ChannelFormat}, " · ") }</span>
						</div>
					}
					if ch.Platform != "" || ch.ChannelBrand != "" {
						<div class="fact">
							<span class="fact__k">Platform</span>
							<span class="fact__v">{ joinNonEmpty([]string{ch.Platform, ch.ChannelBrand}, " · ") }</span>
						</div>
					}
					if ch.Market != "" {
						<div class="fact">
							<span class="fact__k">Market</span>
							<span class="fact__v">{ ch.Market }</span>
						</div>
					}
					if ch.PromotionCode != "" || ch.MaxDiscountRate != nil || ch.PrimaryDiscountType != "" {
						{{ var promoParts []string }}
						if ch.PromotionCode != "" {
							{{ promoParts = append(promoParts, ch.PromotionCode) }}
						}
						if ch.MaxDiscountRate != nil {
							{{ promoParts = append(promoParts, "max "+formatPctHelper(ch.MaxDiscountRate)) }}
						}
						if ch.PrimaryDiscountType != "" {
							{{ promoParts = append(promoParts, ch.PrimaryDiscountType) }}
						}
						<div class="fact">
							<span class="fact__k">Promo</span>
							<span class="fact__v">{ joinNonEmpty(promoParts, " · ") }</span>
						</div>
					}
				</div>
			</div>
			<!-- Staff card -->
			<div class="scard">
				<div class="caption scard__eyebrow" style="color:var(--accent)">STAFF</div>
				<div class="facts" style="margin-top:var(--sp-3)">
					if st.SellerName != "" {
						<div class="fact">
							<span class="fact__k">Seller</span>
							<span class="fact__v">
								{ st.SellerName }
								if st.SellerEmail != "" {
									<span class="muted"> &lt;{ st.SellerEmail }&gt;</span>
								}
							</span>
						</div>
					}
					if st.CreatorName != "" {
						<div class="fact">
							<span class="fact__k">Creator</span>
							<span class="fact__v">{ st.CreatorName }</span>
						</div>
					}
					if st.TeamName != "" {
						<div class="fact">
							<span class="fact__k">Team</span>
							<span class="fact__v">{ st.TeamName }</span>
						</div>
					}
					if st.BranchName != "" {
						<div class="fact">
							<span class="fact__k">Branch</span>
							<span class="fact__v">{ st.BranchName }</span>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
}

// ensure domain import is used
var _ domain.OrderDetail
