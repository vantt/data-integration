package templates

import "github.com/vantt/data-integration/crm/app/internal/domain"

// TaskDoneRow renders a single task row in "done" state.
// Returned as an HTMX swap fragment after PATCH /tasks/{id}/done.
templ TaskDoneRow(t domain.Task) {
	<div class="wl-row wl-row--done" id={ "task-" + t.TaskID }>
		<button class="wl-check wl-check--on" disabled aria-label="done">
			@Icon("check", 13)
		</button>
		<div class="wl-row__main">
			<div class="wl-row__top">
				<span class="chip chip--moss">done</span>
				<span class="wl-row__name">{ t.Title }</span>
			</div>
			if t.CompletedAt != nil {
				<div class="wl-row__meta">
					<span class="wl-row__due">
						@Icon("clock", 11)
						{ formatICTHelper(*t.CompletedAt) }
					</span>
				</div>
			}
		</div>
	</div>
}
