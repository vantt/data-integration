package templates

import (
	"fmt"
	"github.com/vantt/data-integration/crm/app/internal/domain"
)

// DedupReviewPage renders S04 — Dedup Review.
templ DedupReviewPage(candidates []domain.DedupCandidate, partyNames map[string]string, matchRuleFilter string) {
	@AppShell("S04", "Dedup Review") {
		<div class="crm-page page-enter">
			<div class="crm-pagehead">
				<div>
					<div class="caption crm-pagehead__eyebrow">QUẢN TRỊ</div>
					<h1 class="crm-pagehead__title">Trùng lặp chờ duyệt</h1>
				</div>
				<div class="crm-pagehead__aside">
					<span class="bdg bdg--warn">
						<span class="bdg__dot"></span>
						Pending: { fmt.Sprintf("%d", len(candidates)) }
					</span>
					<div class="fsel">
						<div class="caption fsel__label">MATCH RULE</div>
						<div class="fsel__field">
							<select
								name="match_rule"
								hx-get="/dedup"
								hx-target="body"
								hx-push-url="true"
							>
								<option value="" selected?={ matchRuleFilter == "" }>Tất cả quy tắc</option>
								<option value="exact_phone" selected?={ matchRuleFilter == "exact_phone" }>Exact phone</option>
								<option value="exact_email" selected?={ matchRuleFilter == "exact_email" }>Exact email</option>
								<option value="fts_name_phone" selected?={ matchRuleFilter == "fts_name_phone" }>FTS name+phone</option>
							</select>
							<span class="fsel__chev">
								@Icon("chevdown", 12)
							</span>
						</div>
					</div>
				</div>
			</div>

			if len(candidates) == 0 {
				@dedupEmpty()
			} else {
				<div class="dedup-grid">
					<div class="cand-list">
						for _, c := range candidates {
							<div class="cand-row" id={ "cand-" + c.CandidateID }>
								<div class="cand-row__top">
									<span class="cand-row__names">
										{ partyNameOrID(partyNames, c.PartyA) }
										<span class="muted"> vs </span>
										{ partyNameOrID(partyNames, c.PartyB) }
									</span>
								</div>
								<span class="cand-row__rule">{ c.MatchRule }</span>
							</div>
						}
					</div>

					<div>
						for _, c := range candidates {
							@dedupCandidateDetail(c, partyNames)
						}
					</div>
				</div>
			}
		</div>
		@modalContainer()
	}
}

// dedupCandidateDetail renders the compare panel + actions for one candidate pair.
templ dedupCandidateDetail(c domain.DedupCandidate, partyNames map[string]string) {
	<div id={ "detail-" + c.CandidateID }>
		<div class="dedup-compare">
			<div class="dedup-card dedup-card--survive">
				<span class="dedup-card__tag bdg bdg--accent">GIỮ LẠI</span>
				<div class="facts">
					<div class="fact">
						<span class="fact__k">Party A</span>
						<span class="fact__v">{ partyNameOrID(partyNames, c.PartyA) }</span>
					</div>
					<div class="fact">
						<span class="fact__k">ID</span>
						<span class="fact__v mono">{ c.PartyA }</span>
					</div>
					<div class="fact">
						<span class="fact__k">Rule</span>
						<span class="fact__v mono">{ c.MatchRule }</span>
					</div>
					<div class="fact">
						<span class="fact__k">Score</span>
						<span class="fact__v mono">{ fmt.Sprintf("%.2f", c.MatchScore) }</span>
					</div>
				</div>
				<a
					href={ templ.SafeURL("/customers/" + c.PartyA) }
					class="ghost-link"
				>
					Xem hồ sơ
					@Icon("external", 12)
				</a>
			</div>

			<div class="dedup-card">
				<span class="dedup-card__tag bdg">GỘP VÀO</span>
				<div class="facts">
					<div class="fact">
						<span class="fact__k">Party B</span>
						<span class="fact__v">{ partyNameOrID(partyNames, c.PartyB) }</span>
					</div>
					<div class="fact">
						<span class="fact__k">ID</span>
						<span class="fact__v mono">{ c.PartyB }</span>
					</div>
					<div class="fact">
						<span class="fact__k">Thời gian</span>
						<span class="fact__v mono">{ formatICTHelper(c.CreatedAt) }</span>
					</div>
				</div>
				<a
					href={ templ.SafeURL("/customers/" + c.PartyB) }
					class="ghost-link"
				>
					Xem hồ sơ
					@Icon("external", 12)
				</a>
			</div>
		</div>

		<div class="caveat caveat--rule">
			<span class="caveat__mark">
				@Icon("bolt", 13)
			</span>
			Match rule: <b>{ c.MatchRule }</b> · Score { fmt.Sprintf("%.2f", c.MatchScore) } · { formatICTHelper(c.CreatedAt) }
		</div>

		<div class="dedup-detail-actions">
			<button
				class="btn btn--primary"
				hx-get={ "/dedup/" + c.CandidateID + "/modal/merge" }
				hx-target="#modal"
				hx-swap="innerHTML"
			>
				@Icon("merge", 14)
				Merge A&#8592;B
			</button>
			<button
				class="btn btn--secondary"
				hx-post={ "/dedup/" + c.CandidateID + "/reject" }
				hx-target={ "#cand-" + c.CandidateID }
				hx-swap="outerHTML"
				hx-confirm="Từ chối cặp khách này?"
			>Reject</button>
			<button class="btn btn--ghost">Bỏ qua</button>
		</div>
	</div>
}

templ dedupEmpty() {
	<div class="state">
		<div class="state__inner">
			<div class="state__title">Không có candidate nào cần xử lý</div>
			<div class="state__sub">Tất cả cặp khách hàng nghi ngờ trùng đã được xử lý.</div>
		</div>
	</div>
}

// ── pure helpers ──────────────────────────────────────────────────────────────

func partyNameOrID(names map[string]string, partyID string) string {
	if n, ok := names[partyID]; ok && n != "" {
		return n
	}
	return partyID
}
