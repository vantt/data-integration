package templates

import (
	"github.com/vantt/data-integration/crm/app/internal/domain"
)

// ── S13 Settings ──────────────────────────────────────────────────────────────

// SettingsPage renders S13 — Settings with three tabs: Custom Fields, Tags, Users.
templ SettingsPage(
	activeTab string,
	customFields []domain.CustomFieldDef,
	tags []domain.Tag,
	users []domain.AppUser,
) {
	@AppShell("S13", "Cài đặt") {
		@Topbar("⚙️ Cài đặt") {}
		<div class="content-area settings-layout">
			<nav class="settings-nav">
				<a
					href="/settings?tab=custom_fields"
					class={ settingsNavClass(activeTab, "custom_fields") }
				>Custom Fields</a>
				<a
					href="/settings?tab=tags"
					class={ settingsNavClass(activeTab, "tags") }
				>Tags</a>
				<a
					href="/settings?tab=users"
					class={ settingsNavClass(activeTab, "users") }
				>Người dùng</a>
			</nav>
			<div class="settings-content">
				switch activeTab {
					case "tags":
						@SettingsTagsSection(tags)
					case "users":
						@SettingsUsersSection(users)
					default:
						@SettingsCustomFieldsSection(customFields)
				}
			</div>
		</div>
		<div id="modal"></div>
	}
}

// ── Custom Fields tab ─────────────────────────────────────────────────────────

// SettingsCustomFieldsSection renders the Custom Fields sub-section.
templ SettingsCustomFieldsSection(fields []domain.CustomFieldDef) {
	<div class="settings-section">
		<div class="section-header">
			<h3>Custom Fields</h3>
			<button
				class="btn btn-primary btn-sm"
				hx-get="/settings/custom-fields/modal/create"
				hx-target="#modal"
				hx-swap="innerHTML"
			>+ Thêm field</button>
		</div>
		if len(fields) == 0 {
			<p class="text-muted">Chưa có custom field nào.</p>
		} else {
			<table class="data-table">
				<thead>
					<tr>
						<th>Field key</th>
						<th>Nhãn</th>
						<th>Loại</th>
						<th>Bắt buộc</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, f := range fields {
						<tr class="data-row" id={ "cfd-" + f.FieldID }>
							<td><code>{ f.FieldKey }</code></td>
							<td>{ f.Label }</td>
							<td><span class="badge badge-silver">{ f.DataType }</span></td>
							<td>
								if f.IsRequired {
									<span class="badge badge-at-risk">Có</span>
								} else {
									<span class="text-muted">Không</span>
								}
							</td>
							<td>
								<button
									class="btn btn-sm btn-secondary"
									hx-get={ "/settings/custom-fields/" + f.FieldID + "/modal/edit" }
									hx-target="#modal"
									hx-swap="innerHTML"
								>Sửa</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}

// ── Tags tab ──────────────────────────────────────────────────────────────────

// SettingsTagsSection renders the Tags sub-section.
templ SettingsTagsSection(tags []domain.Tag) {
	<div class="settings-section">
		<div class="section-header">
			<h3>Tags</h3>
			<button
				class="btn btn-primary btn-sm"
				hx-get="/settings/tags/modal/create"
				hx-target="#modal"
				hx-swap="innerHTML"
			>+ Tạo tag</button>
		</div>
		if len(tags) == 0 {
			<p class="text-muted">Chưa có tag nào.</p>
		} else {
			<table class="data-table">
				<thead>
					<tr>
						<th>Tên (slug)</th>
						<th>Category</th>
						<th>Màu</th>
					</tr>
				</thead>
				<tbody>
					for _, tag := range tags {
						<tr class="data-row">
							<td><code>{ tag.Name }</code></td>
							<td>
								if tag.Category != "" {
									<span class="badge badge-silver">{ tag.Category }</span>
								} else {
									<span class="text-muted">—</span>
								}
							</td>
							<td>
								if tag.Color != "" {
									<span class="color-swatch" style={ "background:" + tag.Color }>{ tag.Color }</span>
								} else {
									<span class="text-muted">—</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}

// ── Users tab ─────────────────────────────────────────────────────────────────

// SettingsUsersSection renders the Users sub-section (read-only).
templ SettingsUsersSection(users []domain.AppUser) {
	<div class="settings-section">
		<div class="section-header">
			<h3>Người dùng</h3>
		</div>
		if len(users) == 0 {
			<p class="text-muted">Chưa có người dùng nào.</p>
		} else {
			<table class="data-table">
				<thead>
					<tr>
						<th>Họ tên</th>
						<th>Email</th>
						<th>Role</th>
						<th>Trạng thái</th>
					</tr>
				</thead>
				<tbody>
					for _, u := range users {
						<tr class="data-row">
							<td><strong>{ u.FullName }</strong></td>
							<td>{ u.Email }</td>
							<td><span class="badge badge-silver">{ u.Role }</span></td>
							<td>
								if u.IsActive {
									<span class="badge badge-active">Active</span>
								} else {
									<span class="badge badge-churned">Inactive</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}

// ── pure helper ───────────────────────────────────────────────────────────────

func settingsNavClass(active, tab string) string {
	if active == tab {
		return "settings-nav-link active"
	}
	return "settings-nav-link"
}
