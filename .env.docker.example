# ==========================================
# DATA PLATFORM CONFIGURATION — Docker
# ==========================================
# Copy to .env.docker and fill in real values.
# DO NOT commit .env.docker (gitignored).
#
# Generate bcrypt hash for FILESERVER_PASSWORD_HASH:
#   docker run --rm caddy:alpine caddy hash-password --plaintext '<your-password>'
# ==========================================

# ===== [SHARED] =====

TZ=Asia/Ho_Chi_Minh

# ===== [DATA PLATFORM — Orchestration] =====

DAGSTER_PORT=3001
DBT_EXPORT_PATH=/app/var/data_lake/export/marts
DBT_DATA_LAKE_PATH=/app/var/data_lake

# ===== [DATA PLATFORM — Sapo Credentials] =====

SOURCES__SAPO__DOMAIN=fwg.mysapogo.com
SOURCES__SAPO__USERNAME=your_username_here
SOURCES__SAPO__PASSWORD=your_password_here
SOURCES__SAPO__HEADLESS=true

# ===== [DATA PLATFORM — DLT Destination] =====

DESTINATION__FILESYSTEM__BUCKET_URL=file:///app/var/data_lake

# ===== [DATA PLATFORM — Webhook Consumer] =====

WORKER_URL=http://localhost:8787
POLL_LIMIT=100
SLEEP_INTERVAL=5
MIN_SLEEP_INTERVAL=10
MAX_SLEEP_INTERVAL=60

# ===== [DATA PLATFORM — Alerting] =====

LARK_ALERT_WEBHOOK=your_webhook_url
LARK_ALERT_SECRET=your_secret

# ===== [DATA PLATFORM — Metabase Provisioning] =====

METABASE_URL=http://metabase:3000/
METABASE_API_KEY=mb_your_api_key_here
METABASE_DB_NAME=Sapo

# ===== [DATA PLATFORM — Backup] =====

BACKUP_ROOT=/app/var/backups
BACKUP_KEEP_COUNT=7

# ===== [DATA PLATFORM — Google Sheets Sources] =====

SOURCES__SPREADSHEET_URL__TARGETS=https://docs.google.com/spreadsheets/d/YOUR_TARGETS_SHEET_ID/edit
SOURCES__SPREADSHEET_URL__MARKETING_SPEND=https://docs.google.com/spreadsheets/d/YOUR_MARKETING_SHEET_ID/edit
SOURCES__SPREADSHEET_URL__TEAM_CONFIG=https://docs.google.com/spreadsheets/d/YOUR_TEAM_CONFIG_SHEET_ID/edit
SOURCES__SPREADSHEET_URL__OVERHEAD_CLASSIFICATION=https://docs.google.com/spreadsheets/d/YOUR_OVERHEAD_CLASSIFICATION_SHEET_ID/edit?gid=0

# ===== [METABASE] =====

MB_DB_TYPE=h2
MB_DB_FILE=/home/metabase/data/metabase.db

# ===== [FILESERVER — basic_auth] =====
# Protects https://files.etl.lan.fwg.vn/ (standalone DuckDB export).
#
# Generate hash:
#   docker run --rm caddy:alpine caddy hash-password --plaintext '<your-password>'
#
# CRITICAL: Bcrypt hashes contain `$` characters. Docker Compose interpolates
# `$VAR` patterns in env_file values, breaking the hash. You MUST escape every
# `$` to `$$` when pasting the hash here.
#
# Example raw hash:    $2a$14$abc...xyz
# What to paste here:  $$2a$$14$$abc...xyz
# Container receives:  $2a$14$abc...xyz   (correct, single $ — Compose unescapes)

FILESERVER_USER=analyst
FILESERVER_PASSWORD_HASH=<paste-double-dollar-escaped-bcrypt-hash-here>

# ===== [DETAIL VIEW — Order/Customer insight app] =====
# Read-only FastAPI app. Path is the same serving DB Metabase reads (opened read_only).
OLAP_DB_PATH=/app/var/data_lake/serving/olap.duckdb
APP_TZ=Asia/Ho_Chi_Minh
DETAIL_VIEW_PORT=8000

# ===== [CRM REVERSE-ETL TRIGGER] =====
# Shared secret so the data_platform (Dagster) crm_cache_refresh asset can call
# the CRM's POST /admin/refresh after the serving layer rebuilds. MUST match the
# CRM_REFRESH_TOKEN set on the `crm` service in docker-compose.yml.
CRM_REFRESH_TOKEN=change-me-crm-refresh
# Optional override; defaults to the in-network address http://crm:8090/admin/refresh
# CRM_REFRESH_URL=http://crm:8090/admin/refresh
