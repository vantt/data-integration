    'Unknown' as customer_id,
    'Unknown' as full_name,
    'Unknown' as email,
    'Unknown' as phone,
    'Unknown' as customer_segment,
    0 as lifetime_value,
    0 as total_orders_count,
    NULL as created_at,
    NULL as updated_at
    );
  
  
