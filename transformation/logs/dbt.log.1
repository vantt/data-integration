    'Unknown' as district,
    'Unknown' as ward,
    'Unknown' as address1,
    'Unknown' as country,
    'Unknown' as customer_segment,
    0 as lifetime_value,
    0 as total_orders_count,
    NULL as created_at,
    NULL as updated_at
    );
  
  
