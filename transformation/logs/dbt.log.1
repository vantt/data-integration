-- 3. Đóng vai trò là "Virtual Sorted Log": Luôn trả về trạng thái mới nhất của đơn hàng.
-- =================================================================================================

WITH raw_data AS (
    -- Bước 1: Đọc toàn bộ file Parquet từ Data Lake
    -- Nguồn: defined in models/sources.yml (trỏ tới data_lake/sapo_raw/orders)
    SELECT 
