  create view "sapo_warehouse"."main_staging"."stg_targets__dbt_tmp" as (
    

WITH raw_targets AS (
    SELECT * FROM read_parquet('d:/_1.FWG_PARA/1.Projects/dev/dataware_house/data-integration2/data_lake/sapo_raw/targets_raw/**/*.parquet', hive_partitioning=1)
),

sanitized AS (
    SELECT
        -- 1. Setup Date -> Date Key
        try_cast(setup_date as date) as target_date,
        
        -- 2. Business Keys (Handle Empty as 'All')
        coalesce(nullif(trim(branch_code), ''), 'ALL') as branch_code,
        coalesce(nullif(trim(team_code), ''), 'ALL') as team_code,
        coalesce(nullif(trim(staff_email), ''), 'ALL') as staff_email,
        coalesce(nullif(trim(sales_channel), ''), 'ALL') as sales_channel,
        coalesce(nullif(trim(product_sku), ''), 'ALL') as product_sku,
        
        -- 3. Metric & Value
        lower(trim(metric_code)) as metric_code,
        try_cast(target_value as decimal(18,2)) as target_val,
        
        -- 4. Metadata
        description,
        ingest_method,
        year,
        month
        
    FROM raw_targets
),

generated_keys AS (
    SELECT
        *,
        -- Generate Semantic Code: TGT-{Month}-{Branch}-{Team}-{Staff}-{Metric}
        -- We hash this to create the surrogate key
        concat_ws('-', 
            'TGT',
            strftime(target_date, '%Y%m'),
            branch_code,
            team_code,
            staff_email,
            metric_code
        ) as target_code
    FROM sanitized
)

SELECT
    -- Technical Primary Key
    md5(target_code) as target_key,
    
    target_code,
    
    -- Dimensions
    target_date,
    branch_code,
    team_code,
    staff_email,
    sales_channel,
    product_sku,
    
    -- Metrics
    metric_code,
    target_val,
    
    -- Metadata
    description,
    ingest_method
    
FROM generated_keys
WHERE target_val IS NOT NULL
  );

