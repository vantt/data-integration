    create  table
      "sapo_warehouse"."main_marts"."fact_sales__dbt_tmp"
  
    as (
      

WITH items AS (
    SELECT * FROM "sapo_warehouse"."main_staging"."std_order_items"
),
orders AS (
    SELECT * FROM "sapo_warehouse"."main_staging"."std_orders"

),
valid_customers AS (
    SELECT customer_key FROM "sapo_warehouse"."main_marts"."dim_customers_base"
)

SELECT
    -- Surrogate Keys (Foreign Keys to Dims)
    CASE 
        WHEN i.product_id IS NULL OR i.product_id = '' THEN md5(cast(coalesce(cast('Unknown' as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT))
        ELSE md5(cast(coalesce(cast(i.product_id || '-' || coalesce(i.variant_id, '') as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT))
    END as product_key,
    md5(cast(coalesce(cast(coalesce(i.product_type, 'Unknown') as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as category_key,
    COALESCE(vc.customer_key, md5(cast(coalesce(cast('Unknown' as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT))) as customer_key,
    md5(cast(coalesce(cast(cast(o.location_id as string) as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as branch_location_key,
    md5(cast(coalesce(cast(coalesce(o.channel, 'Unknown') as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as channel_key,
    COALESCE(ds.staff_key, md5(cast(coalesce(cast('Unknown' as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT))) as staff_key,
    md5(cast(coalesce(cast(o.status as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as status_key,
    coalesce(cast(strftime(o.created_at, '%Y%m%d') as integer), 19000101) as date_key, -- Link to dim_date YYYYMMDD
    
    -- Degenerate Keys
    i.order_id,
    i.item_id,
    
    -- Metrics
    i.quantity,
    i.total_price as revenue,
    i.weight_grams,
    
    -- Addresses
    -- Addresses
    CASE 
        WHEN o.shipping_province IS NULL THEN md5(cast(coalesce(cast('Unknown' as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT))
        ELSE md5(cast(coalesce(cast(coalesce(o.shipping_province,'') as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(coalesce(o.shipping_district,'') as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(coalesce(o.shipping_ward,'') as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(coalesce(o.shipping_country, 'Vietnam') as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT))
    END as shipping_geography_key,

    CASE 
        WHEN o.billing_province IS NULL THEN md5(cast(coalesce(cast('Unknown' as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT))
        ELSE md5(cast(coalesce(cast(coalesce(o.billing_province,'') as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(coalesce(o.billing_district,'') as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(coalesce(o.billing_ward,'') as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(coalesce(o.billing_country, 'Vietnam') as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT))
    END as billing_geography_key,
    
    -- Pro-rated amounts (Simple logic for now)
    -- Ideally we'd allocate order-level discount to items here
    
    o.created_at as sol_timestamp,
    o.updated_at

FROM items i
JOIN orders o ON i.order_id = o.order_id
LEFT JOIN valid_customers vc ON md5(cast(coalesce(cast(o.customer_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) = vc.customer_key
LEFT JOIN "sapo_warehouse"."main_marts"."dim_staff" ds ON md5(cast(coalesce(cast(o.salesperson_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) = ds.staff_key
    );
  
  
