[0m16:13:09.664685 [debug] [Thread-1 (]: On model.sapo_warehouse.fact_sales: /* {"app": "dbt", "dbt_version": "1.9.2", "profile_name": "sapo_warehouse", "target_name": "dev", "node_id": "model.sapo_warehouse.fact_sales"} */

  
  create view "data_integration2"."main_marts"."fact_sales__dbt_tmp" as (
    

WITH items AS (
    SELECT * FROM "data_integration2"."main_staging"."std_order_items"
),
orders AS (
    SELECT * FROM "data_integration2"."main_staging"."std_orders"
)

SELECT
    -- Surrogate Keys (Foreign Keys to Dims)
    md5(i.product_id || '-' || i.variant_id) as product_key,
    md5(coalesce(i.product_type, 'Uncategorized')) as category_key,
    md5(o.customer_id) as customer_key,
    md5(o.location_id) as location_key,
    md5(o.channel) as channel_key,
    md5(o.salesperson_id) as staff_key,
    md5(o.status) as status_key,
    cast(strftime(o.created_at, '%Y%m%d') as integer) as date_key, -- Link to dim_date YYYYMMDD
    
    -- Degenerate Keys
    i.order_id,
    i.item_id,
    
    -- Metrics
    i.quantity,
    i.total_price as revenue,
    i.weight_grams,
    
    -- Pro-rated amounts (Simple logic for now)
    -- Ideally we'd allocate order-level discount to items here
    
    o.created_at as sol_timestamp

FROM items i
JOIN orders o ON i.order_id = o.order_id
  );

