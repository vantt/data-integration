    create  table
      "sapo_warehouse"."main_staging"."stg_sapo_orders__dbt_tmp"
  
    as (
      

-- =================================================================================================
-- HOP 5: STAGING & CLEANING LAYER - SAPO ORDERS
-- =================================================================================================
-- Purpose:
-- 1. Extract raw JSON fields from `src_sapo_orders` into typed columns.
-- 2. Handle Sapo-specific JSON paths.
-- 3. Incremental Load & Deduplication.
-- OPTIMIZATION: Late Materialization to avoid OOM on large payloads.
-- =================================================================================================

WITH source_data AS (
    SELECT * FROM read_parquet('d:/_1.FWG_PARA/1.Projects/dev/dataware_house/data-integration2/data_lake/sapo_raw/order/**/*.parquet', hive_partitioning=1)
    
),

-- 1. Get Metadata only (lightweight sort)
meta_keys AS (
    SELECT 
        entity_id, 
        event_timestamp, 
        ingest_method
    FROM source_data
),

-- 2. Deduplicate on keys
deduped_keys AS (
    SELECT
        *,
        ROW_NUMBER() OVER (
            PARTITION BY entity_id
            ORDER BY
                event_timestamp DESC,
                CASE
                    WHEN ingest_method = 'webhook' THEN 3
                    WHEN ingest_method = 'history_log' THEN 2
                    ELSE 1
                END DESC
        ) AS rn
    FROM meta_keys
),

-- 3. Select Winner Keys
winner_keys AS (
    SELECT entity_id, event_timestamp, ingest_method
    FROM deduped_keys
    WHERE rn = 1
),

-- 4. Join back to get Payload (Heavy Lift only for winners)
final_source AS (
    SELECT s.*
    FROM source_data s
    INNER JOIN winner_keys k 
    ON s.entity_id = k.entity_id 
    AND s.event_timestamp = k.event_timestamp
    AND s.ingest_method = k.ingest_method
),

json_parsed AS (
    SELECT 
        entity_id,
        entity_type,
        event_timestamp,
        
        -- =========================================================================================
        -- JSON EXTRACTION & TYPE CASTING
        -- =========================================================================================
        
        json_extract_string(payload, '$.id') as order_id,
