    email,
    phone,
    
    -- We can categorize customers based on spending here if needed
    CASE 
        WHEN total_spent > 10000000 THEN 'VIP'
        WHEN total_spent > 5000000 THEN 'Loyal'
        ELSE 'Regular'
    END as customer_segment,
    
    total_spent as lifetime_value,
    total_orders_count,
    
    created_at,
    updated_at

FROM customers

