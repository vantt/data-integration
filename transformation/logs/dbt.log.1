  create view "data_integration2"."main_marts"."dim_promotions__dbt_tmp" as (
    

WITH orders AS (
    SELECT * FROM "data_integration2"."main_marts"."std_orders"
),

unnested_promos AS (
    SELECT 
        order_id,
        unnest(from_json(discount_codes, '["JSON"]')) as promo_json
