  create view "data_integration2"."main_marts"."dim_customers__dbt_tmp" as (
    

WITH customers AS (
    SELECT * FROM "data_integration2"."main_staging"."std_customers"
)

SELECT
    -- Surrogate Key (using md5 for stability)
    md5(customer_id) as customer_key,
    
    -- Natural Keys
