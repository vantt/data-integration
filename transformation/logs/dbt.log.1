[0m23:34:39.520159 [debug] [Thread-1 (]: On model.sapo_warehouse.int_customer_metrics: /* {"app": "dbt", "dbt_version": "1.11.2", "profile_name": "sapo_warehouse", "target_name": "dev", "node_id": "model.sapo_warehouse.int_customer_metrics"} */

  
    
    

    create  table
      "sapo_warehouse"."main_marts"."int_customer_metrics"
  
    as (
      

WITH orders AS (
    SELECT * FROM "sapo_warehouse"."main_marts"."fact_orders"
),

-- Determine which customers need processing
-- If incremental, only fetch customers who had orders in the incoming batch (plus their full history)
changed_customers AS (
    
    SELECT DISTINCT customer_key FROM orders
    
),

customer_orders AS (
    SELECT 
        o.customer_key,
        o.order_id,
        o.order_timestamp,
        o.gmv
    FROM orders o
    
),

aggregated AS (
    SELECT
        customer_key,
        MIN(order_timestamp) as first_order_date,
        MAX(order_timestamp) as last_order_date,
        COUNT(DISTINCT order_id) as frequency,
        SUM(gmv) as monetary_value
    FROM customer_orders
    GROUP BY customer_key
)

SELECT
    customer_key,
    first_order_date,
    last_order_date,
    date_diff('day', CAST(last_order_date AS DATE), current_date) as recency_days,
    frequency,
    monetary_value,
    date_diff('day', CAST(first_order_date AS DATE), CAST(last_order_date AS DATE)) as lifespan_days,
    current_timestamp as metric_calculated_at
FROM aggregated
    );
  
  
  
