[0m13:15:05.660851 [debug] [Thread-1 (]: On model.sapo_warehouse.fact_orders: /* {"app": "dbt", "dbt_version": "1.11.2", "profile_name": "sapo_warehouse", "target_name": "dev", "node_id": "model.sapo_warehouse.fact_orders"} */

  
    
    

    create  table
      "sapo_warehouse"."main_marts"."fact_orders__dbt_tmp"
  
    as (
      

WITH orders AS (
    SELECT * FROM "sapo_warehouse"."main_staging"."std_orders"

),

valid_customers AS (
    SELECT customer_key FROM "sapo_warehouse"."main_marts"."dim_customers_base"
)

SELECT
    -- Keys
    orders.order_id,
    COALESCE(vc.customer_key, md5(cast(coalesce(cast('Unknown' as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT))) as customer_key,
    CASE 
        WHEN shipping_province IS NULL OR shipping_province = '' OR shipping_province = 'Unknown' THEN md5(cast(coalesce(cast('Unknown' as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT))
        ELSE md5(cast(coalesce(cast(trim(coalesce(shipping_province, '')) as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(trim(coalesce(shipping_district, '')) as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(trim(coalesce(shipping_ward, '')) as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(trim(coalesce(shipping_country, 'Vietnam')) as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT))
    END as shipping_geography_key,

    CASE 
        WHEN billing_province IS NULL OR billing_province = '' OR billing_province = 'Unknown' THEN md5(cast(coalesce(cast('Unknown' as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT))
        ELSE md5(cast(coalesce(cast(trim(coalesce(billing_province, '')) as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(trim(coalesce(billing_district, '')) as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(trim(coalesce(billing_ward, '')) as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(trim(coalesce(billing_country, 'Vietnam')) as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT))
    END as billing_geography_key,

    -- Full Address Strings
    concat_ws(', ', nullif(shipping_address1, ''), nullif(shipping_ward, ''), nullif(shipping_district, ''), nullif(shipping_province, ''), coalesce(nullif(shipping_country, ''), 'Vietnam')) as shipping_address,
    concat_ws(', ', nullif(billing_address1, ''), nullif(billing_ward, ''), nullif(billing_district, ''), nullif(billing_province, ''), coalesce(nullif(billing_country, ''), 'Vietnam')) as billing_address,
    
    -- Note: Orders can have multiple promotions. To keep 1:1, we might pick the primary one 
    -- or just bridge it later. For now, we leave NULL or specific handling if needed. 
    -- Simplification: Just take the first code if present, or NULL.
    md5(cast(coalesce(cast(coalesce(json_extract_string(json_extract_string(discount_codes, '$[0]'), '$.code'), 'Unknown') as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as promotion_key,
    md5(cast(coalesce(cast(location_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as branch_location_key,
    md5(cast(coalesce(cast(coalesce(channel, 'Unknown') as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as channel_key,
    COALESCE(ds.staff_key, md5(cast(coalesce(cast('Unknown' as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT))) as staff_key,
    md5(cast(coalesce(cast(status as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as status_key,
    coalesce(cast(strftime(created_at, '%Y%m%d') as integer), 19000101) as date_key,
    
    -- Status Metrics
    status,
    payment_status,
    fulfillment_status,
    
    -- Financial Metrics
    total_amount as gmv,
    total_discount_amount,
    total_tax_amount,
    
    -- Performance Metrics
    -- timestamps difference in hours
    date_diff('hour', created_at, completed_at) as time_to_complete_hours,
    
    created_at as order_timestamp,
    updated_at

FROM orders
LEFT JOIN valid_customers vc ON md5(cast(coalesce(cast(coalesce(cast(orders.customer_id as varchar), 'Unknown') as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) = vc.customer_key
LEFT JOIN "sapo_warehouse"."main_marts"."dim_staff" ds ON md5(cast(coalesce(cast(orders.salesperson_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) = ds.staff_key
    );
  
  
