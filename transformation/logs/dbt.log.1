            PARTITION BY entity_id 
            ORDER BY event_timestamp DESC
        ) as rn
    FROM raw_data
)

-- Bước 3: Filter lấy bản mới nhất
SELECT * EXCLUDE (rn)
FROM deduplicated
WHERE rn = 1
  );

