  create view "sapo_warehouse"."main_staging"."src_sapo_orders__dbt_tmp" as (
    

-- =================================================================================================
-- HOP 4: VIRTUAL STAGING VIEW
-- =================================================================================================
-- Mục đích:
-- 1. Đọc dữ liệu Raw từ Data Lake (file Parquet) do dlt pipeline sinh ra.
