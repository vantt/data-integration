    create  table
      "data_integration2"."main_marts"."dim_promotions__dbt_tmp"
  
    as (
      

WITH orders AS (
    SELECT * FROM "data_integration2"."main_staging"."std_orders"
),

unnested_promos AS (
    SELECT 
        order_id,
        unnest(from_json(discount_codes, 'JSON[]')) as promo_json
    FROM orders
    WHERE discount_codes IS NOT NULL 
      AND discount_codes != '' 
      AND discount_codes != '[]'
      AND discount_codes != 'null'
)

SELECT DISTINCT
    -- Surrogate Key
    md5(json_extract_string(promo_json, '$.code')) as promotion_key,
    
    -- Attributes
