  create view "sapo_warehouse"."main_staging"."std_order_items__dbt_tmp" as (
    

-- =================================================================================================
-- HOP 5: STANDARD ORDER ITEMS - v2.0
-- =================================================================================================

WITH source_data AS (
    SELECT * FROM "sapo_warehouse"."main_staging"."stg_sapo_order_items"
)

SELECT
    -- IDs
    item_id,
    order_id,
    product_id,
    variant_id,
    
    -- Product Info
    sku,
    barcode,
    unit,
    product_name,
    variant_name,
    
    -- Quantity & Price
    quantity,
    unit_price,
    total_price,
    
    -- Enriched Attributes (v2)
