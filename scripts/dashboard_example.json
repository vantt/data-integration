    {
      "name": "Orders by Date",
      "display": "line",
      "dataset_query": {
        "database": null,
        "type": "native",
        "native": {
          "query": "SELECT date_trunc('day', created_at) as day, count(*) FROM orders GROUP BY 1 ORDER BY 1"
        }
      },
       "visualization_settings": {
         "graph.dimensions": [ "day" ],
         "graph.metrics": [ "count" ]
       },
       "position": {
        "size_x": 8,
