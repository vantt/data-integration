#!/bin/sh
# ui-spec pre-commit gate
# Runs only when staged files touch crm/docs/ui-spec/ or .agents/skills/ui-spec/
# Validates spec integrity, regenerates artifacts, checks freshness.

STAGED=$(git diff --cached --name-only)

# -- Early exit: nothing in scope --
echo "$STAGED" | grep -qE '^crm/docs/ui-spec/|^\.agents/skills/ui-spec/' || exit 0

# -- Validate --
OUT=$(node .agents/skills/ui-spec/tools/validate.mjs --root crm/docs/ui-spec 2>&1)
if [ $? -ne 0 ]; then
  echo "$OUT"
  exit 1
fi

# -- Build (suppress stdout, capture stderr for errors) --
node .agents/skills/ui-spec/tools/build.mjs --root crm/docs/ui-spec > /dev/null 2>&1
if [ $? -ne 0 ]; then
  node .agents/skills/ui-spec/tools/build.mjs --root crm/docs/ui-spec 2>&1
  exit 1
fi

# -- Freshness check: did the build change any generated artifact? --
git diff --quiet -- \
  crm/docs/ui-spec/generated/surface-registry.yaml \
  crm/docs/ui-spec/generated/navigation-graph.yaml \
  crm/docs/ui-spec/generated/action-registry.csv \
  crm/docs/ui-spec/generated/coverage-report.md
if [ $? -ne 0 ]; then
  echo "generated/ artifacts were stale — rebuilt; review and stage them"
  exit 1
fi

# -- Tool tests: run when ui-spec tool source files are staged --
echo "$STAGED" | grep -qE '^\.agents/skills/ui-spec/tools/' && {
  npm test --prefix .agents/skills/ui-spec/tools 2>&1 || exit 1
}

echo "ui-spec pre-commit gate: OK"
