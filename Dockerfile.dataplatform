FROM python:3.10-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    build-essential \
    curl \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Node.js 20.x (NodeSource) — required for codex CLI (npm package), used by
# scripts/generate_approach_scripts.py as one of the completion providers.
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# codex CLI headless (`codex exec`) — auth is subscription-based (OAuth), NOT an
# API key: populated by a one-time `docker compose exec data_platform codex login`
# into the `agent_codex_config` named volume (see docker-compose.yml), same
# pattern as ../fgos. Without that login step, codex-based calls fail at call time
# (container still starts fine).
RUN npm install -g @openai/codex

WORKDIR /app

# Copy requirements files
COPY ingestion/requirements.txt /app/ingestion/requirements.txt
COPY scripts/requirements.txt /app/scripts/requirements.txt

# Install dependencies
RUN pip install --no-cache-dir -r ingestion/requirements.txt -r scripts/requirements.txt

# dlt 1.25.0 bug: create_dataset() calls makedirs without exist_ok=True, crashing when
# the dataset directory already exists on second+ runs. Patch until dlt fixes upstream.
RUN sed -i 's/self\.fs_client\.makedirs(self\.dataset_path)$/self.fs_client.makedirs(self.dataset_path, exist_ok=True)/' \
    /usr/local/lib/python3.10/site-packages/dlt/destinations/impl/filesystem/filesystem.py

# Install Playwright browsers and dependencies
# We use --with-deps to install system dependencies (requires apt-get)
# We limit to chromium to save space, remove "chromium" to install all
RUN playwright install --with-deps chromium

RUN mkdir -p /app/var/data_lake /app/var/dagster_home /app/var/logs /app/var/backups /app/var/input_source
# Copy source code
COPY ingestion /app/ingestion
COPY transformation /app/transformation
COPY orchestration /app/orchestration
COPY webhook_consumer /app/webhook_consumer
COPY scripts /app/scripts
# Copy DLT project files (if any at root or needed)
# COPY .dlt /app/.dlt # un-comment if .dlt config is at root and needed

# Set Environment Variables
ENV DAGSTER_HOME=/app/var/dagster_home
ENV PYTHONPATH=/app
ENV DBT_PROJECT_DIR=/app/transformation
ENV DBT_PROFILES_DIR=/app/transformation

# Healthcheck: Dagster webserver exposes /server_info once ready (typically 20-30s startup).
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:3001/server_info || exit 1

# Default command (can be overridden in docker-compose)
CMD ["dagster", "dev", "-h", "0.0.0.0", "-p", "3001", "-f", "orchestration/definitions.py"]
