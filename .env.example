# ==========================================
# DATA PLATFORM CONFIGURATION
# ==========================================
# Copy to .env.docker (Docker) or .env.local (local dev).
# Paths below are Docker defaults (/app/...). For local dev, adjust to Windows paths.
#
# Config layers (high → low precedence):
#   1. docker-compose environment:  — container constants (BACKUP_ROOT, telemetry)
#   2. .env.docker (via env_file:)  — credentials + env-specific overrides
#   3. .env.local (project root)    — local dev overrides
#   4. secrets.toml                 — dlt credentials (alternative to env)
#   5. config.toml                  — dlt defaults (rarely change)
#
# Convention:
#   Uncommented  = must be set by operator (credentials, env-specific)
#   Commented    = has default elsewhere (config.toml / Dockerfile), shown for reference
# ==========================================

# ===== [SHARED] =====

TZ=Asia/Ho_Chi_Minh

# ===== [DATA PLATFORM — Orchestration] =====

DAGSTER_PORT=3001
DBT_EXPORT_PATH=/app/var/data_lake/export/marts
DBT_DATA_LAKE_PATH=/app/var/data_lake
# Local dev (Windows): DBT_DATA_LAKE_PATH=D:/Vantt/app/data-integration/app_data/data_lake

# ===== [DATA PLATFORM — Sapo Credentials] =====
# Maps to dlt.secrets["sources.sapo.*"]

SOURCES__SAPO__DOMAIN=fwg.mysapogo.com
SOURCES__SAPO__USERNAME="your_username_here"
SOURCES__SAPO__PASSWORD="your_password_here"
SOURCES__SAPO__HEADLESS=true
# Default in config.toml — uncomment to override:
# SOURCES__SAPO__REQUEST_DELAY=2.0

# ===== [DATA PLATFORM — DLT Destination] =====

DESTINATION__FILESYSTEM__BUCKET_URL=file:///app/var/data_lake
# Defaults in config.toml — uncomment to override:
# DESTINATION__FILESYSTEM__LOADER_FILE_FORMAT=parquet
# DESTINATION__FILESYSTEM__LAYOUT={table_name}/ingest_method={ingest_method}/year={year}/month={month}/{file_id}.{ext}
# DESTINATION__FILESYSTEM__EXTRA_PLACEHOLDERS={"ingest_method": "text", "year": "text", "month": "text"}

# ===== [DATA PLATFORM — Webhook Consumer] =====

WORKER_URL=http://localhost:8787
POLL_LIMIT=100
SLEEP_INTERVAL=5
MIN_SLEEP_INTERVAL=10
MAX_SLEEP_INTERVAL=60

# ===== [DATA PLATFORM — Alerting] =====

LARK_ALERT_WEBHOOK="your_webhook_url"
LARK_ALERT_SECRET="your_secret"

# ===== [DATA PLATFORM — Metabase Provisioning] =====
# Used by provisioning scripts to configure Metabase via API

METABASE_URL="http://metabase:3000/"
METABASE_API_KEY="mb_your_api_key_here"
METABASE_DB_NAME="Sapo"

# ===== [DATA PLATFORM — Backup] =====

BACKUP_ROOT=/app/var/backups
BACKUP_KEEP_COUNT=7

# ===== [DATA PLATFORM — Google Sheets Sources] =====
# URLs for Google Sheets ingestion (targets, marketing spend, team config)

SOURCES__SPREADSHEET_URL__TARGETS="https://docs.google.com/spreadsheets/d/YOUR_TARGETS_SHEET_ID/edit"
SOURCES__SPREADSHEET_URL__MARKETING_SPEND="https://docs.google.com/spreadsheets/d/YOUR_MARKETING_SHEET_ID/edit"
SOURCES__SPREADSHEET_URL__TEAM_CONFIG="https://docs.google.com/spreadsheets/d/YOUR_TEAM_CONFIG_SHEET_ID/edit"

# Team Config sheet names (default: teams, team_members)
# TEAM_CONFIG_SHEET_TEAMS=teams
# TEAM_CONFIG_SHEET_MEMBERS=team_members

# ===== [DATA PLATFORM — Optional Overrides] =====
# These have code defaults or read from config.toml — uncomment to override:
# SHEETS_SENSOR_TARGETS_URL=https://docs.google.com/.../export?format=csv
# SHEETS_SENSOR_MARKETING_URL=https://docs.google.com/.../export?format=csv
# SERVING_TIMEOUT_SEC=1800
# RILL_PUBLISH_TIMEOUT_SEC=900
# INGESTION_HEALTH_DB=/app/var/data_lake/monitoring/ingestion_health.db

# ===== [METABASE] =====

MB_DB_TYPE=h2
MB_DB_FILE=/home/metabase/data/metabase.db
# Uncomment for Postgres backend:
# MB_DB_DBNAME=metabase
# MB_DB_PORT=5432
# MB_DB_USER=metabase
# MB_DB_PASS=metabase
# MB_DB_HOST=metabase_db

# ===== [RILL — Optional] =====
# Rill uses docker-compose environment: directly, not this file.
# Listed here for reference only:
# RILL_EXPORT_ROOT=/app/var/data_lake/export/rill/current
