# ==========================================
# DATA PLATFORM CONFIGURATION (Example)
# ==========================================

# --- Orchestration (Dagster & dbt) ---
# Subsystem: Dagster / Transformation
# Used by: docker-compose.yml, run_dagster.ps1
DAGSTER_PORT=3001
DBT_EXPORT_PATH=/app/data_lake/export/marts
DBT_DATA_LAKE_PATH=/app/data_lake

# --- Webhook Consumer (Python Script) ---
# Subsystem: Ingestion (Real-time)
# Config: ingestion/run_webhook_consumer.py
WORKER_URL=http://localhost:8787   # Target Cloudflare Worker URL
POLL_LIMIT=100                     # Max messages per poll
SLEEP_INTERVAL=5                   # Base sleep time (s)
MIN_SLEEP_INTERVAL=10              # Min sleep/backoff (s)
MAX_SLEEP_INTERVAL=60              # Max sleep/backoff (s)

# --- Sapo API Credentials (DLT) ---
# Subsystem: Ingestion (Batch)
# Config: ingestion/src/sapo/client.py & secrets.toml [sources.sapo]
# Maps to: dlt.secrets["sources.sapo.domain"]
SOURCES__SAPO__DOMAIN=fwg.mysapogo.com
# Maps to: dlt.secrets["sources.sapo.username"]
SOURCES__SAPO__USERNAME="your_username_here"
# Maps to: dlt.secrets["sources.sapo.password"]
SOURCES__SAPO__PASSWORD="your_password_here"
# Maps to: dlt.secrets["sources.sapo.headless"]
SOURCES__SAPO__HEADLESS=true
# Maps to: dlt.secrets["sources.sapo.request_delay"]
# SOURCES__SAPO__REQUEST_DELAY=2.0


# --- Destination (Filesystem / Bucket) ---
# Subsystem: Ingestion (DLT Destination)
# Config: secrets.toml [destination.filesystem]
# Maps to: dlt.secrets["destination.filesystem.bucket_url"]
DESTINATION__FILESYSTEM__BUCKET_URL=file:///app/data_lake
# Maps to: dlt.secrets["destination.filesystem.loader_file_format"]
DESTINATION__FILESYSTEM__LOADER_FILE_FORMAT=parquet
# Maps to: dlt.secrets["destination.filesystem.layout"]
DESTINATION__FILESYSTEM__LAYOUT={table_name}/ingest_method={ingest_method}/year={year}/month={month}/{file_id}.{ext}
# Maps to: dlt.secrets["destination.filesystem.extra_placeholders"]
DESTINATION__FILESYSTEM__EXTRA_PLACEHOLDERS={"ingest_method": "text", "year": "text", "month": "text"}

# --- Metabase (BI Tool) ---
# Subsystem: Visualization
# Used by: Dockerfile.metabase, scripts/metabase_setup.py
METABASE_URL="http://metabase:3000/"
METABASE_API_KEY="mb_your_api_key_here"
METABASE_DB_NAME="Sapo"

# --- Metabase Database (Internal) ---
# Subsystem: Visualization (Backend DB)
# Used by: metabase docker image entrypoint
MB_DB_TYPE=h2
MB_DB_FILE=/home/metabase/data/metabase.db

# --- Rill (Companion BI Tool) ---
# Subsystem: Visualization / Exploration
# Used by: docker-compose.yml, Dockerfile.rill, rill project source models
RILL_VERSION=v0.85.0
RILL_HOST=0.0.0.0
RILL_PORT=9009
RILL_PROJECT_DIR=/app/rill
RILL_EXPORT_ROOT=/app/data_lake/export/rill/current

# Example Postgres Config (if switching DB_TYPE=postgres)
# MB_DB_DBNAME=metabase
# MB_DB_PORT=5432
# MB_DB_USER=metabase
# MB_DB_PASS=metabase
# MB_DB_HOST=metabase_db

# --- Backup ---
# Subsystem: Maintenance (scheduled daily at 6 AM)
# Used by: orchestration/ops/system-backup.py, scripts/backup/backup.ps1|sh
BACKUP_ROOT=D:\_1.FWG_PARA\1.Projects\dev\dataware_house\backups
BACKUP_KEEP_COUNT=7

# --- System / Timezone ---
TZ=Asia/Ho_Chi_Minh
