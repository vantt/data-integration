# --- Data Platform (Dagster/dbt) ---
DAGSTER_PORT=3001
DBT_EXPORT_PATH=/app/data_lake/export/marts
DBT_DATA_LAKE_PATH=/app/data_lake

# --- Webhook Consumer (Python) ---
WORKER_URL=http://localhost:8787
SOURCE_SYSTEM=sapo
POLL_LIMIT=100
SLEEP_INTERVAL=5
MIN_SLEEP_INTERVAL=10
MAX_SLEEP_INTERVAL=60

# --- Sapo API Credentials ---
SOURCES__SAPO__DOMAIN=fwg.mysapogo.com
SOURCES__SAPO__USERNAME="your_username_here"
SOURCES__SAPO__PASSWORD="your_password_here"
# SOURCES__SAPO__REQUEST_DELAY=2.0 # Optional: Delay in seconds between requests (Default: 0.5)
# SOURCES__SAPO__HEADLESS=true # Optional: Run browser in headless mode (Default: true)

# --- Destination (Filesystem / Bucket) ---
DESTINATION__FILESYSTEM__BUCKET_URL=file:///app/data_lake
DESTINATION__FILESYSTEM__LOADER_FILE_FORMAT=parquet
DESTINATION__FILESYSTEM__LAYOUT={table_name}/ingest_method={ingest_method}/year={year}/month={month}/{file_id}.{ext}
DESTINATION__FILESYSTEM__EXTRA_PLACEHOLDERS={"ingest_method": "text", "year": "text", "month": "text"}

# --- Metabase ---
METABASE_URL="http://metabase:3000/"
METABASE_API_KEY="mb_2r9ndMDpVIkzTLIaBnLofX+mgXxpvfyudQSNaCF6jJw="

# Database Type: h2 or postgres
MB_DB_TYPE=h2

# [H2 Configuration]
# The database file inside the container (without .mv.db extension)
MB_DB_FILE=/home/metabase/data/metabase.db

# [Postgres Configuration] (Uncomment if switching later)
# MB_DB_DBNAME=metabase
# MB_DB_PORT=5432
# MB_DB_USER=metabase
# MB_DB_PASS=metabase
# MB_DB_HOST=metabase_db
