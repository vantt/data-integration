{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analytics/schema/tenant-profile.schema.json",
  "title": "Tenant analytics profile",
  "description": "Explicit per-tenant parameters. Revenue parameters are written out, never inherited, so an upgrade cannot silently change a tenant's numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant",
    "profile_version",
    "locale",
    "revenue",
    "segments"
  ],
  "properties": {
    "tenant": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1
    },
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "currency",
        "week_start"
      ],
      "properties": {
        "timezone": {
          "type": "string",
          "pattern": "^[A-Za-z]+(/[A-Za-z_]+)+$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "week_start": {
          "const": "monday",
          "description": "DuckDB date_trunc('week') is ISO (Monday)"
        }
      }
    },
    "revenue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recognition_date",
        "vat",
        "returns",
        "excluded_statuses"
      ],
      "properties": {
        "recognition_date": {
          "enum": [
            "order_created",
            "delivered"
          ]
        },
        "vat": {
          "enum": [
            "included",
            "excluded",
            "none"
          ],
          "description": "whether net sales include VAT; none = household business without VAT"
        },
        "returns": {
          "enum": [
            "deducted_on_return_date"
          ]
        },
        "excluded_statuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "segments": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/ident"
      },
      "additionalProperties": {
        "type": "object",
        "description": "binding of an abstract segment, per semantic model id",
        "propertyNames": {
          "$ref": "#/$defs/ident"
        },
        "additionalProperties": {
          "$ref": "#/$defs/binding"
        }
      }
    },
    "tenant_params": {
      "type": "object",
      "description": "tenant values that reports reference by name (goals, link templates); never hard-coded in specs",
      "propertyNames": {
        "$ref": "#/$defs/ident"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number"
        ]
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "areas"
      ],
      "description": "permission areas: one static build per area, path-based login in the reverse proxy",
      "properties": {
        "areas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "functions",
              "can_view_cost"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "URL path segment"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "functions": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "EXE",
                    "SAL",
                    "MKT",
                    "FIN",
                    "INV",
                    "LOG",
                    "OPS",
                    "CUS",
                    "UTL"
                  ]
                }
              },
              "can_view_cost": {
                "type": "boolean",
                "description": "may see cost, margin and profit"
              },
              "legacy": {
                "type": "boolean",
                "description": "hand-written pages; not generated by the renderer"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "ident": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "column",
        "op"
      ],
      "properties": {
        "column": {
          "$ref": "#/$defs/ident"
        },
        "via": {
          "$ref": "#/$defs/ident"
        },
        "op": {
          "enum": [
            "is_true",
            "is_false",
            "eq",
            "in"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "eq"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "in"
              }
            }
          },
          "then": {
            "required": [
              "values"
            ]
          }
        }
      ]
    }
  }
}
