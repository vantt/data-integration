# ==========================================
# DOCKER COMPOSE VARIABLE-SUBSTITUTION TEMPLATE
# ==========================================
# Copy to `.env` (project root, gitignored). Docker Compose auto-loads `.env` for
# ${VAR} substitution directly in docker-compose.yml — this is a SEPARATE mechanism
# from `env_file: .env.docker` (see docs/config-guide.md for that layer).
#
# Convention:
#   Uncommented = must be set (compose has no default, or a required-var error)
#   Commented   = optional, has an empty/safe default in docker-compose.yml
# ==========================================

# ===== [Hug] =====
# MUST match the Cloudflare Worker secret (wrangler secret put HUG_ADMIN_SECRET).
# Used by the CRM claim station to sign POST /hug/token/upsert to the deployed Worker.
HUG_ADMIN_SECRET=change-me

# ===== [CRM] =====

# Reverse-ETL refresh token (POST /admin/refresh, X-Refresh-Token header).
CRM_REFRESH_TOKEN=change-me

# Shared secret for CRM /api/* mutation routes (X-CRM-Token header).
CRM_API_TOKEN=change-me

# Cross-origin state-changing request guard — false=log-only, true=block.
# Optional: defaults to false (log-only) in docker-compose.yml.
# CRM_CSRF_ENFORCE=false

# ===== [Cloudflare Access — CRM protection] =====
# aud from CF Dashboard; team domain is <team>.cloudflareaccess.com.
# Optional: unset = auth bypassed (dev/LAN mode).
# CF_ACCESS_AUDIENCE=
# CF_TEAM_DOMAIN=
# CF_ROLE_CLAIM=role
# CF_ROLE_MAP={}

# ===== [Cloudflare Tunnel] =====
# Only needed if the commented-out `cloudflared` service in docker-compose.yml is enabled.
# CLOUDFLARE_TUNNEL_TOKEN=

# ===== [Sapo REST API] =====
# Reserved for future order-code live validation. Currently soft-fails (amber) because
# Sapo uses cookie-only auth. Optional: unset = feature stays disabled.
# SAPO_API_URL=
# SAPO_API_KEY=

# ===== [Drill runner] =====
# Restore-verify drill trigger shared secret (sidecar).
DRILL_TOKEN=change-me
