# ==============================================================================
# PURPOSE: OPTIMIZE DOCKER BUILD CONTEXT
# ------------------------------------------------------------------------------
# This file tells Docker which files to IGNORE when building the image.
# The content of this directory is sent to the Docker daemon during build.
# We exclude large directories like 'app_data/' (data lake), '.git', and 'venv'
# to prevent the "transferring context" step from taking forever (e.g., 11GB upload).
# ==============================================================================

# Git
.git
.gitignore

# Environment variables (security)
.env
.env.local
.env.*
!.env.example
!.env.docker

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# Data & Logs (The main culprits for large context)
app_data/
logs/
data/

# DBT
transformation/**/target/
transformation/**/dbt_packages/
transformation/**/logs/

# IDE
.vscode/
.idea/

# OS
Thumbs.db
Desktop.ini

# CRM — exclude runtime data, venv, test artifacts, and doc tooling from build context.
# The build stage regenerates *_templ.go; pre-generated copies are included but overwritten.
crm/data/
crm/sync/.venv/
crm/sync/__pycache__/
crm/sync/tests/
crm/docs/
crm/plans/
crm/*.db
crm/**/__pycache__/
crm/**/node_modules/

# Documentation & planning (no runtime value in image)
plans/
docs/

# Ad-hoc root-level analysis scripts (not needed in any image)
check_*.py
_tmp_*.py
_tmp_*.sh

# Python tooling artifacts
.pytest_cache/
**/.pytest_cache/
**/.mypy_cache/
node_modules/
**/node_modules/
