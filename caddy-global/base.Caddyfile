# Global options for caddy-global (front proxy).
# Loaded via CADDY_DOCKER_CADDYFILE_PATH; merged with the label-derived config.
{
	# ACME DNS-01 via Cloudflare for every public-domain cert (e.g. *.lan.fwg.vn).
	# .local domains are unaffected — Caddy still issues those from its internal CA.
	# Token comes from the container env (passed from .env.docker).
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}

	# Expiry notifications (optional; need not be a receivable mailbox for issuance).
	email admin@fwg.vn
}

# fgos-dev moved to design-lab (Tailscale 100.66.22.20) — Docker bridge networks
# don't span hosts, so the usual label auto-discovery on caddy_net can't reach it.
# Static block instead; cert already issued for this host from the prior label config.
fgos-dev.lan.fwg.vn {
	reverse_proxy 100.66.22.20:5173
}
